---
import Layout from '../../layouts/Layout.astro';

import Hero from '../../components/clareamento/Hero.astro';
import SelosMobile from '../../components/clareamento/SelosMobile.astro';
import Incluso from '../../components/clareamento/Incluso.astro';
import Destaque from '../../components/clareamento/Destaque.astro';
import Branco from '../../components/clareamento/Branco.astro';
import Funciona from '../../components/clareamento/Funciona.astro';
import Resultados from '../../components/Resultados.astro';
import Dra from '../../components/Dra.astro';
import Depoimentos from '../../components/Depoimentos.astro';
import Espaco from '../../components/Espaco.astro';
import FAQ from '../../components/FAQ.astro';
import Rodape from '../../components/Rodape.astro';
import BarraMarca from '../../components/BarraMarca.astro';
import BotaoFlutuante from '../../components/BotaoFlutuante.astro';

const faqItens = [
  { q: 'Existe um número máximo de sessões?', a: 'Não. Você faz quantas forem necessárias até atingir o seu branco máximo, medido pela escala de cor.' },
  { q: 'Preciso ir com que frequência?', a: 'Depende de cada caso. Definimos o intervalo ideal entre as sessões na sua avaliação, respeitando a resposta dos seus dentes.' },
  { q: 'O clareamento dental dói ou causa sensibilidade?', a: 'A maioria das pessoas sente pouca ou nenhuma sensibilidade. Quando aparece, é passageira, e ajustamos o protocolo para o seu conforto.' },
  { q: 'Quantas sessões são necessárias para ver resultado?', a: 'Os primeiros resultados costumam aparecer já nas primeiras sessões. O número total depende do seu ponto de partida e do seu branco máximo.' },
  { q: 'Quanto tempo dura o clareamento dental?', a: 'O branco é garantido por até 2 anos. Com o clareamento caseiro que você leva para casa, dá para manter o resultado por ainda mais tempo.' },
  { q: 'Posso fazer clareamento se tenho restaurações ou resina?', a: 'Sim, mas restaurações e resinas não mudam de cor com o clareamento. Avaliamos o seu caso para alinhar as expectativas e, se necessário, trocar restaurações após o tratamento.' },
  { q: 'O clareamento dental é seguro?', a: 'Sim, quando feito com acompanhamento profissional. Todo o processo é conduzido pela Dra. Daiane, com produtos regularizados e protocolo individual.' },
];

const nav = [
  { texto: 'O tratamento', href: '#tratamento' },
  { texto: 'Como funciona', href: '#como-funciona' },
  { texto: 'Resultados', href: '#resultados' },
  { texto: 'Depoimentos', href: '#depoimentos' },
  { texto: 'Dúvidas', href: '#duvidas' },
];
const linksRodape = [
  { texto: 'Dra. Daiane Carvalho', href: '/' },
  { texto: 'Tratamento de canal', href: '/endodontia' },
];
---
<Layout
  title="Clareamento dental sem limite de sessões | Dra. Daiane Carvalho, Barra Funda, SP"
  description="Clareamento dental com sessões ilimitadas até o seu branco máximo, limpeza profunda e clareamento caseiro inclusos. Barra Funda, São Paulo. Fale no WhatsApp."
  origem="landing_clareamento"
>
  <BarraMarca nav={nav} />
  <div class="lp">
    <Hero />
    <SelosMobile />
    <Incluso />
    <Destaque />
    <Branco />
    <Funciona />
    <Resultados />
    <Dra />
    <Depoimentos contexto="clareamento" />
    <Espaco />
    <FAQ itens={faqItens} />
    <Rodape ctaMensagem="Olá! Quero agendar o meu clareamento." links={linksRodape} />
  </div>
  <BotaoFlutuante mensagem="Olá! Tenho interesse no clareamento dental." />
</Layout>
