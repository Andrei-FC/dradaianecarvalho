---
import Layout from '../../layouts/Layout.astro';
import BarraMarca from '../../components/BarraMarca.astro';
import BotaoFlutuante from '../../components/BotaoFlutuante.astro';
import Hero from '../../components/endodontia/Hero.astro';
import SelosBanda from '../../components/endodontia/SelosBanda.astro';
import Situacoes from '../../components/endodontia/Situacoes.astro';
import CardDestaque from '../../components/CardDestaque.astro';
import Video from '../../components/endodontia/Video.astro';
import Funciona from '../../components/endodontia/Funciona.astro';
import Dra from '../../components/Dra.astro';
import Depoimentos from '../../components/Depoimentos.astro';
import Espaco from '../../components/Espaco.astro';
import FAQ from '../../components/FAQ.astro';
import Rodape from '../../components/Rodape.astro';
import clinica from '../../data/clinica.json';
import { servico, breadcrumb, faqPage, grafo } from '../../lib/jsonld';

const nav = [
  { texto: 'O tratamento',  href: '#tratamento' },
  { texto: 'Como funciona', href: '#como-funciona' },
  { texto: 'A Dra. Daiane', href: '#dra-daiane' },
  { texto: 'Depoimentos',   href: '#depoimentos' },
  { texto: 'Dúvidas',       href: '#duvidas' },
];
const linksRodape = [
  { texto: 'Dra. Daiane Carvalho', href: '/' },
  { texto: 'Clareamento dental',   href: '/clareamento/' },
];

// Horário derivado do clinica.json — a mesma fonte do rodapé e do JSON-LD.
// Escrito à mão em dois lugares, um dia diverge (seção 1.2).
const abertos = clinica.horario.filter(d => d.aberto);
const listar = (ds: string[]) => {
  const n = ds.map((d, i) => (i === 0 ? d : d.toLowerCase()));
  return n.length === 1 ? n[0] : `${n.slice(0, -1).join(', ')} e ${n[n.length - 1]}`;
};
const grupos: { dias: string[]; abre: string; fecha: string }[] = [];
for (const d of abertos) {
  const g = grupos.find(x => x.abre === d.abre && x.fecha === d.fecha);
  if (g) g.dias.push(d.curto); else grupos.push({ dias: [d.curto], abre: d.abre!, fecha: d.fecha! });
}
const horarioFrase = grupos
  .map(g => `${listar(g.dias).toLowerCase()}, das ${g.abre} às ${g.fecha}`)
  .join(', e ');

const faq = [
  { q: 'Atende urgência? Consigo ser atendida hoje?',
    a: `O consultório da Dra. Daiane Carvalho atende ${horarioFrase}. O atendimento é sempre com hora marcada, mas a marcação é rápida e feita pelo WhatsApp, então casos de dor costumam ser encaixados no mesmo dia ou no dia seguinte. Fora do horário de atendimento, a Dra. Daiane responde sempre que possível, orienta o que fazer para aliviar a dor e confirma o horário mais próximo disponível. Mande mensagem contando o que está sentindo.` },
  { q: 'Como sei que preciso de tratamento de canal?',
    a: 'Os sinais mais comuns são dor espontânea, dor que piora à noite, sensibilidade prolongada ao quente ou ao frio, dor ao mastigar, inchaço na gengiva perto do dente e escurecimento do dente. Só o exame clínico com radiografia confirma a indicação. Se você tem algum desses sinais, mande mensagem no WhatsApp descrevendo o que está sentindo.' },
  { q: 'O tratamento de canal dói?',
    a: 'A ideia de que o tratamento de canal dói ficou no passado. Com anestesia bem feita e técnica moderna, o objetivo é você não sentir dor durante o procedimento. Na verdade, ele costuma acabar com a dor que te trouxe até aqui.' },
  { q: 'Quantas sessões são necessárias?',
    a: 'A maioria dos casos é finalizada em uma única sessão. Alguns casos mais complexos podem precisar de uma segunda. Se for o seu caso, eu explico o porquê antes de começar.' },
  // Posição 5 por decisão da 1.11.4: esta pergunta subiu da 14 e substituiu
  // 'O dente vai precisar de coroa depois do tratamento de canal?', que dizia a
  // mesma coisa nove itens adiante, não mencionava que é feito no consultório e
  // usava 'coroa' nos dois sentidos — a anatômica do dente e a protética — na
  // mesma resposta.
  { q: 'Depois do canal, o dente precisa de mais alguma coisa?',
    a: 'Precisa ser reabilitado. Quando o dente conserva bastante estrutura, a restauração definitiva resolve. Quando sobrou pouca, entra o pino, que é o reforço para receber a coroa. Os dois caminhos são feitos aqui, no mesmo consultório: o dente sai fechado, e não com uma etapa pendente para resolver em outro lugar.' },
  { q: 'Dá mesmo para salvar o dente?',
    a: 'Na maioria das vezes, sim. O tratamento de canal remove a infecção de dentro do dente e permite mantê-lo no lugar, evitando a extração. Salvar o dente natural é quase sempre a melhor escolha.' },
  { q: 'Vale mais a pena fazer o tratamento de canal ou extrair o dente?',
    a: 'Sempre que o dente ainda tem estrutura suficiente para ser restaurado, mantê-lo é a melhor escolha. O dente natural preserva a mastigação e evita que os vizinhos se desloquem para o espaço vazio, o que depois exige implante ou prótese. A Dra. Daiane Carvalho indica a extração apenas quando o dente não tem mais condição de ser mantido.' },
  { q: 'Quanto tempo dura o atendimento?',
    a: 'Em geral, cerca de 2 horas, porque é feito com calma e capricho, pra resolver bem de uma vez. Você fica sabendo do tempo estimado do seu caso na avaliação.' },
  { q: 'E se, ao avaliar, não der para fazer o tratamento de canal?',
    a: 'Se ao examinar o dente for identificada alguma condição que impeça o tratamento, eu te explico com clareza quais são as alternativas antes de qualquer coisa. Você nunca fica sem entendimento do que está acontecendo.' },
  { q: 'É seguro?',
    a: 'Sim. Todo o tratamento é conduzido pela Dra. Daiane, com técnica atual, materiais de qualidade e todo o cuidado com segurança e higiene.' },
  { q: 'Estou grávida. Posso fazer tratamento de canal?',
    a: 'Sim. A gestante pode e deve fazer o tratamento de canal quando há indicação. Uma infecção dentária não tratada representa risco maior para a gestação do que o tratamento em si. Informe a Dra. Daiane Carvalho sobre a gravidez e o tempo de gestação na avaliação.' },
  { q: 'Já fiz tratamento de canal e o dente voltou a doer. Tem solução?',
    a: 'Sim. Quando um dente já tratado volta a doer, existe o retratamento endodôntico: o material antigo é removido, o canal é limpo novamente e reselado. A Dra. Daiane Carvalho avalia com radiografia se o retratamento é possível no seu caso.' },
  // Logo depois do retratamento, que é a sequência clínica: quem tem pino para
  // tirar é quem vai retratar. É a única resposta da página que diz `pino` duas
  // vezes, e é de propósito — esta é a FAQ que atende quem digitou a palavra no
  // Google. A pergunta antiga ('Preciso tirar um pino antigo') era a chegada que
  // a Dra. diz não existir: a pessoa tem um dente tratado, não um problema de
  // pino. E se o dente tem pino, tem coroa — as duas peças saem juntas.
  { q: 'Meu dente já tratado tem pino. Dá para refazer o canal?',
    a: 'Dá. Quando o dente tem pino, tem também uma coroa por cima, e as duas peças saem antes do retratamento. A radiografia da avaliação mostra a condição da raiz e o que vai ser preciso para reabilitar o dente depois. Remoção, retratamento e a reabilitação são feitos no mesmo consultório — você não precisa procurar outro profissional em nenhuma etapa.' },
  { q: 'Outro dentista abriu o meu dente e me encaminhou. Dá para terminar aí?',
    a: 'Dá, e é uma das situações mais comuns aqui. Me chama no WhatsApp contando o que já foi feito e, se tiver a radiografia, manda junto. Na avaliação eu examino o que está aberto e explico o que falta antes de continuar.' },
  { q: 'Preciso levar raio-X ou algum exame?',
    a: 'Não. A radiografia é feita no próprio consultório, no momento da avaliação. É ela que mostra a real situação da raiz e permite planejar o tratamento com precisão, sem suposição sobre o que precisa ser feito.' },
  { q: 'Como eu marco?',
    a: 'É só me chamar no WhatsApp contando o que está sentindo. A partir daí agendamos a sua avaliação no melhor dia para você.' },
  { q: 'Quanto custa?',
    a: 'O valor depende do dente e da complexidade do caso, e eu confirmo isso na avaliação, antes de começar qualquer tratamento. Me chama no WhatsApp que eu te explico o seu caso.' },
  { q: 'Atende convênio?',
    a: 'Não. O consultório da Dra. Daiane Carvalho atende apenas em regime particular, sem convênios.' },
];

const jsonLd = grafo(
  servico({
    nome: 'Tratamento de canal (endodontia)',
    descricao: 'Tratamento de canal com anestesia bem feita e técnica moderna, na maioria dos casos em uma única sessão, no consultório da Dra. Daiane Carvalho na Barra Funda, São Paulo.',
    caminho: '/endodontia/',
  }),
  breadcrumb('Tratamento de canal', '/endodontia/'),
  faqPage(faq),
);
---
<Layout
  title="Tratamento de canal e Endodontia na Barra Funda, São Paulo | Dra. Daiane Carvalho"
  description="Tratamento de canal na Barra Funda, São Paulo. Anestesia bem feita e técnica moderna, na maioria dos casos em uma única sessão. Consultório particular."
  origem="landing_endodontia"
  jsonLd={jsonLd}
>
  <BarraMarca nav={nav} />
  <div class="lp">
    <Hero />
    <SelosBanda />
    <Situacoes id="tratamento" />

    <section class="conforto section">
      <div class="container">
        <CardDestaque
          cor="teal"
          titulo="Na maioria dos casos, resolve em uma sessão"
          texto="Canal único costuma ser feito do começo ao fim no mesmo dia: menos idas e vindas, menos faltas no trabalho, menos anestesia. Casos mais complexos podem levar mais de uma sessão, e você sabe disso na avaliação, não no meio do caminho."
        />
      </div>
    </section>

    <Video />
    <Funciona id="como-funciona" />
    <Dra
      id="dra-daiane"
      label="Quem vai cuidar de você"
      titulo="Dra. Daiane Carvalho"
      texto="A Dra. Daiane Carvalho é cirurgiã-dentista com especialização em Endodontia, a área que trata o canal do dente. Atendo canal, retratamento e a reabilitação do dente — restauração, pino e coroa —, com anestesia bem feita e técnica atual. O tratamento de canal existe para manter o dente, em vez de partir para a extração. Explico cada etapa antes de fazer, para você saber exatamente o que vai acontecer."
    />
    <Depoimentos id="depoimentos" contexto="endodontia" />
    <Espaco id="consultorio" />
    <FAQ id="duvidas" itens={faq} />
    <Rodape ctaMensagem="Olá! Gostaria de combinar um horário." links={linksRodape} />
  </div>
  <BotaoFlutuante mensagem="Olá! Gostaria de avaliar um tratamento de canal." rotulo="Falar com o consultório no WhatsApp sobre tratamento de canal" />
</Layout>

<style is:global>
  .conforto { background: var(--superficie-respiro); }
</style>
