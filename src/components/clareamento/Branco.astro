---
// Seção "O que é o seu branco máximo" (Figma: "Branco Máximo").
import TituloSecao from '../TituloSecao.astro';
import BotaoWhatsApp from '../BotaoWhatsApp.astro';

const TEXTO = 'Todo dente tem um limite natural de clareamento, que é o ponto mais branco que a sua estrutura dental consegue atingir. Ao final de cada sessão, a cor é medida com uma escala padronizada. Quando ela se estabiliza entre uma sessão e outra, você chegou ao seu branco máximo. Por isso as sessões são ilimitadas: o limite não é um número, é o seu resultado.';
---
<section class="branco section">
  <div class="container branco-inner">
    <div class="branco-col">
      <TituloSecao label="Como o resultado é medido" titulo="O que é o seu branco máximo" />
      <p class="tipo-corpo branco-texto">{TEXTO}</p>
      <BotaoWhatsApp texto="Tirar uma dúvida" mensagem="Olá! Tenho uma dúvida sobre o clareamento dental." posicao="branco" icone={false} class="branco-cta" />
    </div>
    <div class="branco-video">
      <iframe src="https://www.youtube-nocookie.com/embed/5JrUhSAutXE?rel=0&amp;modestbranding=1&amp;playsinline=1" title="O que é o branco máximo" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
    </div>
  </div>
</section>

<style is:global>
    .branco { background: var(--superficie-card); }
    .branco h2 { color: var(--texto-titulo); }
    .branco .branco-texto { color: var(--texto-suave); margin: 0 0 var(--spacing-lg); }
    .branco-video {
      aspect-ratio: 1160 / 1164; width: 100%;
      border-radius: var(--radius-md); overflow: hidden; background: var(--superficie-escura);
    }
    .branco-video iframe { width: 100%; height: 100%; border: 0; display: block; }
    .branco .btn-whatsapp { width: 100%; }
    .branco-inner { display: flex; flex-direction: column; gap: var(--spacing-lg); }
    .branco-col { display: contents; }
    .branco .section-head { order: 1; margin-bottom: 0; }
    .branco .branco-texto { order: 2; }
    .branco-video { order: 3; }
    .branco .branco-cta { order: 4; }
    @media (min-width: 768px) {
      .branco-inner { display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-lg); align-items: center; }
      .branco-col { display: flex; flex-direction: column; gap: var(--spacing-2xl); order: 1; }
      .branco .section-head, .branco .branco-texto, .branco .branco-cta { order: 0; margin-bottom: 0; }
      .branco .branco-texto { margin: 0; }
      .branco-video { order: 2; }
      .branco .btn-whatsapp { width: 335px; max-width: 100%; }
    }
</style>
