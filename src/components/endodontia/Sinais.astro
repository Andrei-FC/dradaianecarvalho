---
// Seção "É canal?" (Figma: bloco "Incluso" reaproveitado como sinais).
// 4 Card Serviço (via átomo CardIcone). Educação leve: reconhecer sintoma → falar no zap.
// ÍCONE = PLACEHOLDER: um mesmo ícone dental repetido nos 4, deixando claro que falta trocar.
import TituloSecao from '../TituloSecao.astro';
import CardIcone from '../CardIcone.astro';

// Ícone placeholder único (dental) — repetido nos 4 cards. 2ª rodada troca por ícones reais.
const sinais = [
  { titulo: 'Dor forte ou latejante', texto: 'Aquela dor que pulsa, que aparece sozinha e às vezes piora à noite ou ao deitar.' },
  { titulo: 'Sensibilidade que não passa', texto: 'Dói com o quente ou o gelado e a dor demora a ir embora, mesmo depois de tirar o estímulo.' },
  { titulo: 'Dente escurecido', texto: 'Um dente que mudou de cor e ficou mais acinzentado ou escuro que os vizinhos.' },
  { titulo: 'Inchaço ou "bolinha" na gengiva', texto: 'Um inchaço na gengiva perto do dente, às vezes com um carocinho que aparece e some.' },
];
---
<section class="sinais section">
  <div class="container">
    <TituloSecao
      label="É canal?"
      titulo="Reconhece algum destes sinais?"
      subtitulo="Se você marcou algum destes, provavelmente é caso de avaliar o canal. Me chama que eu te oriento."
    />
    <div class="cards sinais-cards">
      {sinais.map((s) => (
        <CardIcone titulo={s.titulo} texto={s.texto}>
          <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="var(--teal-600)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-placeholder="icone"><path d="M12 5.5c-1.5-2-4-2.5-5.5-1.5C4.5 5.5 4 8.5 5 12c.6 2 1 4 1.5 5.5.4 1.2 1.6 1.5 2.2.4.5-1 .8-2.4 1.3-2.4s.8 1.4 1.3 2.4c.6 1.1 1.8.8 2.2-.4C14 15.5 14.4 14 15 12c1-3.5.5-6.5-1.5-8-1.5-1-4-.5-5.5 1.5"/></svg>
        </CardIcone>
      ))}
    </div>
  </div>
</section>

<style is:global>
    .sinais { background: var(--superficie-card); }
    @media (min-width: 768px) {
      .sinais-cards { flex-wrap: nowrap; }
    }
</style>
