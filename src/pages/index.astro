---
import Layout from '../layouts/Layout.astro';
import '../styles/base.css';

import Hero from '../components/home/Hero.astro';
import Especialidades from '../components/home/Especialidades.astro';
import Dra from '../components/Dra.astro';
import Depoimentos from '../components/Depoimentos.astro';
import Espaco from '../components/Espaco.astro';
import Rodape from '../components/Rodape.astro';
import BarraFixa from '../components/BarraFixa.astro';
---
<Layout
  title="Dra. Daiane Carvalho — Consultório odontológico na Barra Funda, SP"
  description="Consultório da Dra. Daiane Carvalho na Barra Funda, São Paulo: clínica geral, endodontia, clareamento e estética do sorriso. 31 avaliações 5 estrelas. Fale no WhatsApp."
  origem="home"
>
  <div class="lp">
    <Hero />
    <Especialidades />
    <Dra />
    <Depoimentos titulo="O que dizem os nossos pacientes" />
    <Espaco />
    <Rodape
      titulo="Fale com o consultório"
      ctaTexto="Falar no WhatsApp"
      ctaMensagem="Olá! Gostaria de saber mais sobre os atendimentos da Dra. Daiane."
    />
  </div>
  <BarraFixa texto="Falar no WhatsApp" mensagem="Olá! Gostaria de saber mais sobre os atendimentos da Dra. Daiane." />
</Layout>
