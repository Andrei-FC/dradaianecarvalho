+---
+// Seção · Casos (raios-X de tratamentos reais). Espelha a galeria full-bleed
+// de Resultados, mas com placeholders enquanto os raios-X reais não entram.
+// Quando Andrei subir as imagens (public/assets/images/Endo-CasoN.jpg),
+// trocar cada .is-placeholder por <img src=...>.
+import TituloSecao from '../TituloSecao.astro';
+---
+<section class="casos section">
+  <div class="container">
+    <TituloSecao label="Casos reais" titulo="Tratamentos feitos pela Dra. Daiane" />
+    <div class="galeria">
+      <div class="ph is-placeholder casos-ph">Raio-X do caso 1</div>
+      <div class="ph is-placeholder casos-ph">Raio-X do caso 2</div>
+      <div class="ph is-placeholder casos-ph">Raio-X do caso 3</div>
+      <div class="ph is-placeholder casos-ph">Raio-X do caso 4</div>
