<span class="icone-ui" style={`width:${tamanho}px;height:${tamanho}px`} set:html={svg} />
<style is:global>
  .icone-ui { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .icone-ui svg { width: 100%; height: 100%; display: block; }
</style>
