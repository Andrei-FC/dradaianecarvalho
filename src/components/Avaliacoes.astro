---
// Seção de avaliações. As reviews vêm de avaliacoes.json (fonte única).
// O avatar genérico é o mesmo para todas — sem foto de pessoa real (sem consentimento).
import avaliacoes from '../data/avaliacoes.json';
---
<section class="avaliacoes section">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow tipo-label">O que dizem</p>
      <h2 class="tipo-titulo">Pacientes reais, resultados reais</h2>
    </div>
    <div class="avaliacoes-grid">
      {avaliacoes.map((a) => (
        <article class="avaliacao">
          <div class="avaliacao-head">
            <span class="avatar"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12a5 5 0 100-10 5 5 0 000 10zm0 2c-4 0-8 2-8 6v2h16v-2c0-4-4-6-8-6z"></path></svg></span>
            <div>
              <p class="avaliacao-nome">{a.nome}</p>
              <p class="estrelas">★★★★★</p>
            </div>
          </div>
          <p class="texto">{`\u201c${a.texto}\u201d`}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style is:global>
    .avaliacoes { background: var(--superficie-respiro); }
    .avaliacoes-grid {
      display: flex; gap: var(--spacing-lg);
      overflow-x: auto; scroll-snap-type: x mandatory;
      margin-left: calc(-1 * var(--spacing-xl)); margin-right: calc(-1 * var(--spacing-xl));
      padding-left: var(--spacing-xl); padding-right: var(--spacing-xl);
      scroll-padding-left: var(--spacing-xl);
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none; -ms-overflow-style: none;
    }
    .avaliacoes-grid::-webkit-scrollbar { display: none; }
    .avaliacao {
      flex: 0 0 220px; scroll-snap-align: start;
      background: var(--superficie-card); border: 1px solid var(--borda-sutil);
      border-radius: var(--radius-lg); padding: var(--spacing-lg);
      display: flex; flex-direction: column; gap: var(--spacing-sm);
    }
    .avaliacao-head { display: flex; align-items: center; gap: var(--spacing-sm); }
    .avatar { width: 40px; height: 40px; border-radius: var(--radius-full); background: var(--teal-100); flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
    .avatar svg { width: 24px; height: 24px; fill: var(--teal-600); }
    .avaliacao-nome { color: var(--texto-forte); font-weight: 600; font-size: 14px; line-height: 1.3; margin: 0; }
    .estrelas { color: var(--estrela); font-size: 13px; line-height: 1.4; margin: 2px 0 0; }
    .avaliacao p.texto { color: var(--texto-suave); margin: 0; font-size: 16px; line-height: 1.6; }
    @media (min-width: 768px) {
      .avaliacoes-grid {
        flex-wrap: nowrap; overflow-x: auto; justify-content: flex-start;
        margin-left: calc(50% - 50vw); margin-right: calc(50% - 50vw);
        padding-left: max(var(--spacing-xl), calc(50vw - 600px + var(--spacing-xl)));
        padding-right: max(var(--spacing-xl), calc(50vw - 600px + var(--spacing-xl)));
        scroll-padding-left: max(var(--spacing-xl), calc(50vw - 600px + var(--spacing-xl)));
      }
      .avaliacoes-grid .avaliacao { flex: 0 0 280px; }
    }
</style>
