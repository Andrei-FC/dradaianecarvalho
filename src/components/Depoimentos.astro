---
// Seção · Depoimentos (Figma: "Seção · Depoimentos").
// Compõe TituloSecao + faixa de CardAvaliacao iterando sobre avaliacoes.json.
import TituloSecao from './TituloSecao.astro';
import CardAvaliacao from './CardAvaliacao.astro';
import avaliacoes from '../data/avaliacoes.json';

interface Props {
  label?: string;
  titulo?: string;
  /** filtra as avaliações pelo campo `contextos` do avaliacoes.json.
      REGRA DURA 1: em /endodontia não entram avaliações que mencionem
      clareamento/estética (coerência de contexto vale mais que quantidade).
      REGRA DURA 2 (conformidade, não design): o texto de uma avaliação pode ser
      editado para retirar o que o consultório realiza mas não divulga — idade de
      paciente infantil, botox, extração (ver 1.2.1 do documento mestre). NÃO
      encurtar por espaço: o card recorta no CSS e o HTML carrega o texto inteiro. */
  contexto: 'home' | 'endodontia' | 'clareamento';
  id?: string;
}
const { label = 'O que dizem', titulo = 'Pacientes reais, resultados reais', contexto, id } = Astro.props;
const lista = avaliacoes.filter((a) => a.contextos.includes(contexto));
// limiar de recorte: ~6 linhas de 16px num card de 280px. Calculado no build,
// para o "Ler mais" existir sem medir nada no navegador.
const LIMITE_CLAMP = 170;
---
<section class="avaliacoes section" id={id}>
  <div class="container">
    <TituloSecao label={label} titulo={titulo} />
    <div class="avaliacoes-grid">
      {lista.map((a, i) => <CardAvaliacao nome={a.nome} depoimento={a.texto} id={`av-${contexto}-${i}`} longo={a.texto.length > LIMITE_CLAMP} />)}
    </div>
  </div>
</section>

<style is:global>
    .avaliacoes { background: var(--superficie-respiro); }
    .avaliacoes-grid {
      display: flex; gap: var(--spacing-lg);
      overflow-x: auto; scroll-snap-type: x mandatory;
      margin-left: calc(-1 * var(--spacing-xl)); margin-right: calc(-1 * var(--spacing-xl));
      padding-left: var(--spacing-xl); padding-right: var(--spacing-xl);
      scroll-padding-left: var(--spacing-xl);
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none; -ms-overflow-style: none;
    }
    .avaliacoes-grid::-webkit-scrollbar { display: none; }
    @media (min-width: 768px) {
      .avaliacoes-grid {
        flex-wrap: nowrap; overflow-x: auto; justify-content: flex-start;
        margin-left: calc(50% - 50vw); margin-right: calc(50% - 50vw);
        padding-left: max(var(--spacing-xl), calc(50vw - 600px + var(--spacing-xl)));
        padding-right: max(var(--spacing-xl), calc(50vw - 600px + var(--spacing-xl)));
        scroll-padding-left: max(var(--spacing-xl), calc(50vw - 600px + var(--spacing-xl)));
      }
    }
</style>
