---
// 4 mini-cards do hero de endodontia (Figma: "Mini Card").
// ATENÇÃO: usam o banco de ícones de INTERFACE, não o dental. O Figma mapeia
// calendário, carinha, selo de check e cartão — não desenhos de dente.
import IconeUI from '../IconeUI.astro';

const selos = [
  { label: 'Geralmente 1 sessão',   icone: 'calendario' },
  { label: 'Anestesia sem dor',     icone: 'carinha-feliz' },
  { label: 'Salva o dente natural', icone: 'selo-check' },
  { label: 'Pagamento facilitado',  icone: 'cartao' },
] as const;
---
<div class="selo-grid">
  {selos.map((s) => (
    <div class="selo">
      <span class="selo-ico"><IconeUI nome={s.icone} tamanho={20} /></span>
      <span class="tipo-label selo-label">{s.label}</span>
    </div>
  ))}
</div>

<style is:global>
    .selo-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-md); }
    .selo {
      background: var(--superficie-card); border-radius: var(--radius-md);
      padding: var(--spacing-md); display: flex; align-items: center; gap: var(--spacing-sm);
    }
    .selo-ico {
      background: var(--marca-primaria); border-radius: var(--radius-full);
      width: 32px; height: 32px; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      color: var(--texto-sobre-primaria);
    }
    .selo-label { color: var(--texto-titulo); text-transform: none; letter-spacing: 0; }
</style>
