---
// Card com ícone (Figma: "Card"). Átomo reutilizável extraído do Incluso.
// Ícone + badge opcional no topo; título + texto abaixo. Caixa branca com borda.
// O ícone entra via <slot> (SVG verbatim do Figma). O badge é opcional.
interface Props {
  titulo: string;
  texto: string;
  /** badge opcional no topo direito (ex: "incluso") */
  badge?: string;
  /** lista de itens abaixo do texto (cards de serviço da home) */
  itens?: string[];
  /** link opcional no pé do card */
  link?: { texto: string; href: string };
}
const { titulo, texto, badge, itens = [], link } = Astro.props;
---
<article class="card">
  <div class="card-top">
    <span class="card-ico"><slot /></span>
    {badge && <span class="badge">{badge}</span>}
  </div>
  <h3 class="tipo-subtitulo">{titulo}</h3>
  <p class="tipo-corpo">{texto}</p>
  {itens.length > 0 && (
    <ul class="card-itens tipo-corpo">
      {itens.map((i) => <li>{i}</li>)}
    </ul>
  )}
  {link && <a class="card-link tipo-corpo-forte" href={link.href}>{link.texto}</a>}
</article>

<style is:global>
    /* Box do card + grid — antes viviam presos no Incluso.astro. */
    .cards { display: flex; flex-direction: column; gap: var(--spacing-md); padding-top: var(--spacing-md); }
    .card {
      background: var(--superficie-card); border: 1px solid var(--borda-sutil);
      border-radius: var(--radius-lg); padding: var(--spacing-xl);
      display: flex; flex-direction: column; gap: var(--spacing-md);
    }
    .card-top { display: flex; align-items: center; justify-content: space-between; }
    .card-ico { width: 44px; height: 44px; color: var(--marca-primaria-escura); flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
    .card-ico svg { width: 44px; height: 44px; }
    .badge {
      background: var(--superficie-acento-claro); color: var(--marca-acento-escura);
      font-size: var(--font-size-legenda); font-weight: 400; line-height: 1.4;
      padding: var(--spacing-xs) var(--spacing-md);
      border-radius: var(--radius-full); white-space: nowrap;
    }
    .card h3 { color: var(--texto-titulo); margin: 0; }
    .card-itens { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--spacing-xs); color: var(--texto-suave); }
    .card-itens li { display: flex; align-items: baseline; gap: var(--spacing-sm); }
    .card-itens li::before { content: ""; width: 5px; height: 5px; border-radius: 50%; background: var(--marca-primaria); flex-shrink: 0; }
    .card-link { color: var(--marca-primaria); text-decoration: underline; text-underline-offset: 3px; margin-top: auto; }
    .card-link:hover { color: var(--marca-primaria-escura); }
    .card p { color: var(--texto-suave); margin: 0; }
    @media (min-width: 768px) {
      .cards { flex-direction: row; }
      .card { flex: 1; }
    }
</style>
