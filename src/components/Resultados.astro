---
// Seção · Resultados (Figma: "Seção · Resultados").
// Galeria de fotos antes/depois. Título e IMAGENS por prop — antes as 5 fotos
// de clareamento estavam hardcoded aqui, o que fazia a landing de endodontia
// exibir resultados de clareamento. Cada página passa as suas.
import TituloSecao from './TituloSecao.astro';

interface Props {
  label?: string;
  titulo?: string;
  imagens?: { src: string; alt: string; w?: number; h?: number }[];
  id?: string;
}

// Alt diferenciado por caso. NÃO usar as palavras "antes" e "depois": o Código
// de Ética veda essas expressões na identificação de foto de caso clínico, e o
// alt é identificação.
const CLAREAMENTO = [1, 2, 3, 4, 5].map((n) => ({
  src: `/assets/images/Resultado-Clareamento-Dental${n}.jpg`,
  alt: `Resultado de clareamento dental, caso ${n}, realizado no consultório da Dra. Daiane Carvalho na Barra Funda, São Paulo`,
  w: 512, h: 627,
}));

const {
  label = 'Resultados reais',
  titulo = 'Sorrisos que falam por si',
  imagens = CLAREAMENTO,
  id,
} = Astro.props;
---
<section class="resultados section" id={id}>
    <div class="container">
      <TituloSecao label={label} titulo={titulo} />
      <div class="galeria">
        {imagens.map((img) => <div class="ph"><img src={img.src} alt={img.alt} width={img.w} height={img.h} loading="lazy" decoding="async"></div>)}
      </div>
    </div>
  </section>

<style is:global>
    .resultados { background: var(--superficie-alternada); }
    @media (min-width: 768px) {
      .resultados .galeria .ph img { height: 100%; object-fit: cover; }
    }
</style>
