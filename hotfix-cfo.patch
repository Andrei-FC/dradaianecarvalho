From b4aaac16d979c22aaa18ee6d17b71c1943585fde Mon Sep 17 00:00:00 2001
From: Claude <c@local>
Date: Mon, 31 Aug 2026 19:45:10 +0000
Subject: [PATCH] CFO: remove preco, condicao de pagamento e gratuidade das
 tres paginas

Varredura da secao 11.3/11.4 do documento mestre foi feita no Figma mas nunca
chegou ao codigo. Estes tres textos estavam publicados:

- endodontia, FAQ 'Quanto custa?': 'Da pra parcelar no cartao'
- clareamento, FAQ sessoes ilimitadas: 'sem custo adicional'
- endodontia, selo do hero: 'Parcela no cartao' -> 'Pagamento facilitado'
---
 src/components/endodontia/Selos.astro | 2 +-
 src/pages/clareamento/index.astro     | 2 +-
 src/pages/endodontia/index.astro      | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/components/endodontia/Selos.astro b/src/components/endodontia/Selos.astro
index b1baff1..1dcf842 100644
--- a/src/components/endodontia/Selos.astro
+++ b/src/components/endodontia/Selos.astro
@@ -9,7 +9,7 @@ const selos = [
   { label: 'Geralmente 1 sessão', icone: null },
   { label: 'Anestesia sem dor', icone: 'anestesia' },
   { label: 'Salva o dente natural', icone: null },
-  { label: 'Parcela no cartão', icone: 'cartao' },
+  { label: 'Pagamento facilitado', icone: 'cartao' },
 ] as const;
 ---
 <div class="selo-grid">
diff --git a/src/pages/clareamento/index.astro b/src/pages/clareamento/index.astro
index da7ebce..3b27234 100644
--- a/src/pages/clareamento/index.astro
+++ b/src/pages/clareamento/index.astro
@@ -17,7 +17,7 @@ import Rodape from '../../components/Rodape.astro';
 import BarraFixa from '../../components/BarraFixa.astro';
 
 const faqItens = [
-  { q: 'Existe um número máximo de sessões?', a: 'Não. Você faz quantas forem necessárias até atingir o seu branco máximo, medido pela escala de cor, sem custo adicional.' },
+  { q: 'Existe um número máximo de sessões?', a: 'Não. Você faz quantas forem necessárias até atingir o seu branco máximo, medido pela escala de cor.' },
   { q: 'Preciso ir com que frequência?', a: 'Depende de cada caso. Definimos o intervalo ideal entre as sessões na sua avaliação, respeitando a resposta dos seus dentes.' },
   { q: 'O clareamento dental dói ou causa sensibilidade?', a: 'A maioria das pessoas sente pouca ou nenhuma sensibilidade. Quando aparece, é passageira, e ajustamos o protocolo para o seu conforto.' },
   { q: 'Quantas sessões são necessárias para ver resultado?', a: 'Os primeiros resultados costumam aparecer já nas primeiras sessões. O número total depende do seu ponto de partida e do seu branco máximo.' },
diff --git a/src/pages/endodontia/index.astro b/src/pages/endodontia/index.astro
index d3b1444..0a9d7a9 100644
--- a/src/pages/endodontia/index.astro
+++ b/src/pages/endodontia/index.astro
@@ -23,7 +23,7 @@ const faqItens = [
   { q: 'E se, ao avaliar, não der para fazer o canal?', a: 'Se ao examinar o dente for identificada alguma condição que impeça o tratamento, eu te explico com clareza quais são as alternativas antes de qualquer coisa. Você nunca fica sem entendimento do que está acontecendo.' },
   { q: 'É seguro?', a: 'Sim. Todo o tratamento é conduzido pela Dra. Daiane, com técnica atual, materiais de qualidade e todo o cuidado com segurança e higiene.' },
   { q: 'Como eu marco?', a: 'É só me chamar no WhatsApp contando o que está sentindo. A partir daí agendamos a sua avaliação no melhor dia para você.' },
-  { q: 'Quanto custa?', a: 'O valor depende do dente e da complexidade, que eu confirmo na avaliação. Dá pra parcelar no cartão. Me chama no WhatsApp que eu te passo os detalhes do seu caso.' },
+  { q: 'Quanto custa?', a: 'O valor depende do dente e da complexidade do caso, e eu confirmo isso na avaliação, antes de começar qualquer tratamento. Me chama no WhatsApp que eu te explico o seu caso.' },
 ];
 ---
