      background: var(--superficie-card); border-radius: var(--radius-md);
      padding: var(--spacing-md); display: flex; align-items: center; gap: var(--spacing-sm);
    }
    .selo-ico {
      background: var(--teal-600); border-radius: var(--radius-full);
      width: 32px; height: 32px; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
    }
    .selo-ico svg { width: 20px; height: 20px; }
    .selo span { color: var(--teal-800); font-weight: 600; font-size: var(--font-size-label); line-height: 1.3; }
</style>
