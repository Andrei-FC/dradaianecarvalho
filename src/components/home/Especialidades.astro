---
// Seção de especialidades da HOME (Figma: "Incluso", frame 2604:433 desktop).
// 4 Card Serviço em grade 2x2 no desktop, empilhados no mobile.
// Título, texto, lista e ícone vêm VERBATIM do Figma; o link só existe
// onde há landing dedicada (endodontia e clareamento). Clínica geral e
// estética não têm Ads nem landing — são menção (ver PROJETO §2.5).
import TituloSecao from '../TituloSecao.astro';
import IconeDental from '../IconeDental.astro';

const especialidades = [
  {
    icone: 'limpeza',
    titulo: 'Limpeza e Prevenção',
    texto: 'Limpeza profissional, aplicação de flúor e orientações de higiene bucal.',
    itens: ['Profilaxia', 'Remoção de tártaro', 'Aplicação de flúor', 'Orientação de escovação'],
    href: null,
  },
  {
    icone: 'obturacao',
    titulo: 'Clínica Geral',
    texto: 'Tratamentos básicos como restaurações, extrações e check-ups regulares.',
    itens: ['Restaurações', 'Extrações', 'Check-ups', 'Diagnósticos'],
    href: null,
  },
  {
    icone: 'clareamento',
    titulo: 'Estética Dental',
    texto: 'Clareamento e tratamentos para um sorriso mais bonito.',
    itens: ['Clareamento', 'Restaurações estéticas', 'Check-ups'],
    href: '/clareamento',
  },
  {
    icone: 'canal',
    titulo: 'Endodontia',
    texto: 'Tratamento de canal com tecnologia moderna e menor desconforto.',
    itens: ['Tratamento de canal', 'Retratamento', 'Apicectomia', 'Diagnóstico pulpar'],
    href: '/endodontia',
  },
] as const;
---
<section class="especialidades section">
  <div class="container">
    <TituloSecao
      label="O que oferecemos"
      titulo="Tudo o que o seu sorriso precisa, em um só lugar"
      subtitulo="Da rotina aos tratamentos especializados, com atendimento próximo e humano."
    />
    <div class="esp-grid">
      {especialidades.map((e) => {
        const Tag = e.href ? 'a' : 'article';
        return (
          <Tag class:list={['esp-card', e.href && 'esp-card--link']} href={e.href ?? undefined}>
            <span class="card-ico"><IconeDental nome={e.icone} /></span>
            <h3 class="tipo-subtitulo">{e.titulo}</h3>
            <p class="tipo-corpo">{e.texto}</p>
            <ul class="esp-itens tipo-corpo">
              {e.itens.map((i) => <li>{i}</li>)}
            </ul>
            {e.href && (
              <span class="esp-link">
                Ver mais
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            )}
          </Tag>
        );
      })}
    </div>
  </div>
</section>

<style is:global>
    .especialidades { background: var(--superficie-pagina); }
    .esp-grid { display: flex; flex-direction: column; gap: var(--spacing-md); padding-top: var(--spacing-md); }
    .esp-card {
      background: var(--superficie-card); border: 1px solid var(--borda-sutil);
      border-radius: var(--radius-lg); padding: var(--spacing-xl);
      display: flex; flex-direction: column; gap: var(--spacing-md);
    }
    .esp-card h3 { color: var(--texto-titulo); margin: 0; }
    .esp-card p { color: var(--texto-suave); margin: 0; }
    .esp-itens { color: var(--texto-suave); margin: 0; padding-left: var(--spacing-xl); }
    .esp-itens li { margin: 0; }
    .esp-card--link { text-decoration: none; transition: border-color 0.18s ease, transform 0.18s ease; }
    .esp-card--link:hover { border-color: var(--marca-primaria); transform: translateY(-2px); }
    .esp-card--link:focus-visible { outline: 3px solid var(--marca-primaria-escura); outline-offset: 2px; }
    .esp-link {
      display: inline-flex; align-items: center; gap: var(--spacing-xs);
      color: var(--marca-primaria); font-weight: 800; font-size: 16px;
      margin-top: auto;
    }
    .esp-link svg { flex-shrink: 0; }
    @media (min-width: 768px) {
      .esp-grid { flex-direction: row; flex-wrap: wrap; }
      .esp-card { flex-basis: calc(50% - var(--spacing-md)); flex-grow: 1; }
    }
</style>
