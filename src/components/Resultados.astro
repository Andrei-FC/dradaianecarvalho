---
// Seção · Resultados (Figma: "Seção · Resultados").
// Galeria de fotos antes/depois. Título por prop; imagens variam por serviço.
import TituloSecao from './TituloSecao.astro';
interface Props {
  label?: string;
  titulo?: string;
}
const { label = 'Resultados reais', titulo = 'Sorrisos que falam por si' } = Astro.props;
---
<section class="resultados section">
    <div class="container">
      <TituloSecao label={label} titulo={titulo} />
      <div class="galeria">
        <div class="ph"><img src="/assets/images/Resultado-Clareamento-Dental1.jpg" alt="Resultado de clareamento dental"></div>
        <div class="ph"><img src="/assets/images/Resultado-Clareamento-Dental2.jpg" alt="Resultado de clareamento dental"></div>
        <div class="ph"><img src="/assets/images/Resultado-Clareamento-Dental3.jpg" alt="Resultado de clareamento dental"></div>
        <div class="ph"><img src="/assets/images/Resultado-Clareamento-Dental4.jpg" alt="Resultado de clareamento dental"></div>
        <div class="ph"><img src="/assets/images/Resultado-Clareamento-Dental5.jpg" alt="Resultado de clareamento dental"></div>
      </div>
    </div>
  </section>

<style is:global>
    .resultados { background: var(--mauve-50); }
    @media (min-width: 768px) {
      .resultados .galeria .ph img { height: 100%; object-fit: cover; }
    }
</style>
