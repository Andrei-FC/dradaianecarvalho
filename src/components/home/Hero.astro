---
// Hero da home institucional. Superfície ESCURA (Figma) — a home abre com o
// bloco de marca e não com fundo claro como as landings.
import BotaoWhatsApp from '../BotaoWhatsApp.astro';
---
<header class="hero-home is-escura section">
  <div class="container hero-home-inner">
    <div class="hero-home-col">
      <div class="hero-home-title-block">
        <span class="hero-home-badge tipo-label">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="var(--estrela)" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          100% de avaliações 5 estrelas no Google
        </span>
        <h1 class="tipo-display">Consultório odontológico na Barra Funda</h1>
        <p class="eyebrow tipo-label">Dra. Daiane Carvalho</p>
      </div>
      <p class="lead tipo-subtitulo">Limpeza, restauração, clareamento e tratamento de canal. Atendimento de terça a sábado, com hora marcada, em Barra Funda, São Paulo.</p>
      <p class="lead tipo-corpo">A marcação é pelo WhatsApp e costuma ser rápida.</p>
      <BotaoWhatsApp texto="Falar com o consultório" mensagem="Olá! Gostaria de saber mais sobre os atendimentos da Dra. Daiane." posicao="hero" icone={false} />
    </div>
    <div class="ph hero-home-img">
      <img fetchpriority="high" decoding="async" src="/assets/images/Hero-principal.jpg" width="840" height="938" alt="Dra. Daiane Carvalho finalizando um tratamento de canal no consultório na Barra Funda, São Paulo">
    </div>
  </div>
</header>

<style is:global>
    .hero-home { background: var(--superficie-escura); }
    .hero-home-badge {
      display: inline-flex; align-self: flex-start; width: auto; align-items: center; gap: var(--spacing-xs);
      background: var(--marca-primaria-escura); color: var(--texto-sobre-escuro);
      padding: var(--spacing-xs) var(--spacing-md); border-radius: var(--radius-full);
      margin: 0; text-transform: none; letter-spacing: 0;
    }
    .hero-home-title-block { display: flex; flex-direction: column; align-items: flex-start; gap: var(--spacing-md); }
    .hero-home-col { display: flex; flex-direction: column; gap: var(--spacing-lg); }
    .hero-home h1 { color: var(--texto-sobre-primaria); margin: 0; }
    .hero-home .lead { color: var(--texto-sobre-escuro); margin: 0; }
    .hero-home-img { width: 100%; border-radius: var(--radius-md); margin-top: var(--spacing-xl); }
    .hero-home-img img { height: auto; object-fit: contain; }
    .hero-home .btn-whatsapp { width: 100%; }
    @media (min-width: 768px) {
      .hero-home-inner { display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-2xl); align-items: center; }
      .hero-home-img { margin-top: 0; }
      .hero-home .btn-whatsapp { width: 350px; max-width: 100%; }
    }
</style>
