---
import Layout from '../../layouts/Layout.astro';

import Hero from '../../components/clareamento/Hero.astro';
import SelosMobile from '../../components/clareamento/SelosMobile.astro';
import Incluso from '../../components/clareamento/Incluso.astro';
import Destaque from '../../components/clareamento/Destaque.astro';
import Branco from '../../components/clareamento/Branco.astro';
import Funciona from '../../components/clareamento/Funciona.astro';
import Resultados from '../../components/Resultados.astro';
import Dra from '../../components/Dra.astro';
import Depoimentos from '../../components/Depoimentos.astro';
import Espaco from '../../components/Espaco.astro';
import FAQ from '../../components/FAQ.astro';
import Rodape from '../../components/Rodape.astro';
import BarraMarca from '../../components/BarraMarca.astro';
import BotaoFlutuante from '../../components/BotaoFlutuante.astro';

const faqItens = [
  { q: 'Existe um número máximo de sessões?', a: 'Não. Você faz quantas sessões forem necessárias até atingir o seu branco máximo, medido pela escala de cor.' },
  { q: 'Preciso ir com que frequência?', a: 'Recomendamos no máximo 15 dias entre as sessões, para o resultado avançar de forma constante até o seu branco máximo.' },
  { q: 'O clareamento dental dói ou causa sensibilidade?', a: 'O receio de sensibilidade é comum, e é justamente por isso que o clareamento aqui inclui um protocolo dessensibilizante, aplicado durante as sessões para reduzir o desconforto. Somado a produtos profissionais e ao acompanhamento de perto da Dra. Daiane, o tratamento fica muito mais tranquilo do início ao fim.' },
  { q: 'O que posso comer e beber depois da sessão?', a: 'Nos dias seguintes à sessão, evite alimentos e bebidas de corante forte: café, chá preto, vinho tinto, refrigerante de cola, molho de tomate e beterraba. O resto da alimentação segue normal. A Dra. Daiane Carvalho orienta ao fim de cada sessão por quanto tempo manter o cuidado.' },
  { q: 'Quantas sessões são necessárias para ver resultado?', a: 'O clareamento é progressivo e na primeira sessão já dá para notar a diferença. Como as sessões são ilimitadas, seguimos até você chegar ao resultado ideal.' },
  { q: 'Quanto tempo dura o clareamento dental?', a: 'Com os cuidados certos, o resultado pode durar até 2 anos. A manutenção é simples: boa higiene, evitar excesso de pigmentos como café e vinho, e revisões periódicas.' },
  { q: 'Posso fazer clareamento se tenho restaurações ou resina?', a: 'Sim, mas o ideal é clarear primeiro. Restaurações e resinas não mudam de cor com o clareamento, então podem ser ajustadas depois para igualar ao novo tom dos dentes.' },
  { q: 'O clareamento dental é seguro?', a: 'Sim. É um procedimento seguro quando feito por dentista, com avaliação prévia, produtos profissionais e acompanhamento em todas as etapas.' },
  { q: 'Grávida pode fazer clareamento dental?', a: 'Não é recomendado. Não há pesquisas científicas que garantam que os produtos clareadores sejam totalmente seguros para o feto, por isso o clareamento é adiado para depois da gestação.' },
  { q: 'Atende convênio?', a: 'Não. O consultório da Dra. Daiane Carvalho atende apenas em regime particular, sem convênios.' },
];

const nav = [
  { texto: 'O tratamento', href: '#tratamento' },
  { texto: 'Como funciona', href: '#como-funciona' },
  { texto: 'Resultados', href: '#resultados' },
  { texto: 'Depoimentos', href: '#depoimentos' },
  { texto: 'Dúvidas', href: '#duvidas' },
];
const linksRodape = [
  { texto: 'Dra. Daiane Carvalho', href: '/' },
  { texto: 'Tratamento de canal', href: '/endodontia' },
];
---
<Layout
  title="Clareamento dental sem limite de sessões | Dra. Daiane Carvalho, Barra Funda, SP"
  description="Clareamento dental com sessões ilimitadas até o seu branco máximo, limpeza profunda e clareamento caseiro inclusos. Barra Funda, São Paulo. Fale no WhatsApp."
  origem="landing_clareamento"
>
  <BarraMarca nav={nav} />
  <div class="lp">
    <Hero />
    <SelosMobile />
    <Incluso id="tratamento" />
    <Destaque />
    <Branco />
    <Funciona id="como-funciona" />
    <Resultados id="resultados" />
    <Dra
      id="dra-daiane"
      label="Quem cuida do seu sorriso"
      titulo="Dra. Daiane Carvalho"
      texto="A Dra. Daiane Carvalho é cirurgiã-dentista e atende clareamento e estética do sorriso na Barra Funda, em São Paulo. Trabalho com protocolo dessensibilizante e acompanhamento em cada sessão, para o resultado ficar natural e o processo ser confortável. Você sabe desde a avaliação o que dá para alcançar no seu caso."
    />
    <Depoimentos id="depoimentos" contexto="clareamento" />
    <Espaco id="consultorio" />
    <FAQ id="duvidas" itens={faqItens} />
    <Rodape ctaMensagem="Olá! Quero agendar o meu clareamento." links={linksRodape} />
  </div>
  <BotaoFlutuante mensagem="Olá! Tenho interesse no clareamento dental." />
</Layout>
