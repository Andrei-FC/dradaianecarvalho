---
// Hero da landing de clareamento. Demanda considerada: tom de vitrine.
// No desktop a faixa de selos vive aqui; no mobile vira SelosMobile.
import SelosGrid from './SelosGrid.astro';
import BotaoWhatsApp from '../BotaoWhatsApp.astro';

const LEAD_SELOS = 'Sessões ilimitadas em consultório até você atingir o seu branco máximo, com limpeza profunda e clareamento caseiro inclusos por metade do valor desses procedimentos separados.';
const MSG = 'Olá! Gostaria de avaliar o meu sorriso para um clareamento.';
---
<header class="hero section">
  <div class="container hero-inner">
    <div class="hero-col">
      <div class="hero-title-block">
        <span class="hero-badge tipo-label">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="var(--estrela)" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          100% de avaliações 5 estrelas no Google
        </span>
        <h1 class="tipo-display">Clareamento dental sem limite de sessões</h1>
      </div>
      <p class="lead tipo-subtitulo">Resultados visíveis desde a primeira sessão, com branco que dura até 2 anos com os cuidados certos.</p>

      <div class="hero-selos">
        <p class="lead tipo-corpo">{LEAD_SELOS}</p>
        <BotaoWhatsApp texto="Avaliar o meu sorriso" mensagem={MSG} posicao="hero" icone={false} />
        <SelosGrid />
      </div>
    </div>
    <div class="ph hero-img"><img fetchpriority="high" decoding="async" width="1000" height="1234" src="/assets/images/Dra-daiane-carvalho-clareamento.jpg" alt="Dra. Daiane Carvalho, dentista na Barra Funda, em atendimento de clareamento dental"></div>
  </div>
</header>

<style is:global>
    .hero { background: var(--superficie-card); }
    .hero.section { padding-bottom: 0; }
    .hero-inner { padding-top: var(--spacing-2xl); }
    .hero-badge {
      display: inline-flex; align-self: flex-start; width: auto; align-items: center; gap: var(--spacing-xs);
      background: var(--superficie-alternada); color: var(--texto-titulo);
      padding: var(--spacing-xs) var(--spacing-md); border-radius: var(--radius-full);
      margin: 0; text-transform: none; letter-spacing: 0;
    }
    .hero-title-block { display: flex; flex-direction: column; align-items: flex-start; gap: var(--spacing-md); }
    .hero-col { display: flex; flex-direction: column; gap: var(--spacing-sm); }
    .hero h1 { color: var(--texto-titulo); margin: 0; }
    .hero .lead { color: var(--texto-suave); margin: 0; }
    /* Sem aspect-ratio fixo: a foto define a própria altura. Proporção travada
       aqui cortava qualquer foto que não fosse exatamente 902x1004. */
    .hero-img { width: 100%; border-radius: 0; }
    .hero-img img { height: auto; object-fit: contain; }
    .hero-selos { display: none; }
    @media (min-width: 768px) {
      .hero-inner { display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-2xl); align-items: center; }
      .hero-col { display: flex; flex-direction: column; gap: var(--spacing-2xl); }
      .hero .lead { margin: 0; }
      .hero-selos { display: flex; flex-direction: column; gap: var(--spacing-md); }
      .hero .btn-whatsapp { width: 350px; max-width: 100%; }
    }
</style>
