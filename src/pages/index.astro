---
import Layout from '../layouts/Layout.astro';
import BarraMarca from '../components/BarraMarca.astro';
import BotaoFlutuante from '../components/BotaoFlutuante.astro';
import Hero from '../components/home/Hero.astro';
import Especialidades from '../components/home/Especialidades.astro';
import Dra from '../components/Dra.astro';
import Depoimentos from '../components/Depoimentos.astro';
import Espaco from '../components/Espaco.astro';
import FAQ from '../components/FAQ.astro';
import Rodape from '../components/Rodape.astro';
import clinica from '../data/clinica.json';
import { dentist, person, faqPage, grafo } from '../lib/jsonld';

const nav = [
  { texto: 'Serviços',      href: '#servicos' },
  { texto: 'A Dra. Daiane', href: '#dra-daiane' },
  { texto: 'Depoimentos',   href: '#depoimentos' },
  { texto: 'O consultório', href: '#consultorio' },
  { texto: 'Dúvidas',       href: '#duvidas' },
];
const linksRodape = [
  { texto: 'Tratamento de canal', href: '/endodontia/' },
  { texto: 'Clareamento dental',  href: '/clareamento/' },
];

const faqItens = [
  { q: 'Onde fica o consultório da Dra. Daiane Carvalho?',
    a: 'O consultório da Dra. Daiane Carvalho fica na L. Padre Péricles, 145, Sala 141 A, na Barra Funda, zona oeste de São Paulo (SP).' },
  { q: 'Quais são os horários de atendimento?',
    a: 'O consultório atende às terças, quintas e sextas, das 08:00 às 18:00, e aos sábados, das 12:00 às 17:00. Nos domingos, segundas e quartas não há atendimento. O atendimento é sempre com hora marcada, em qualquer dia.' },
  { q: 'Como funciona a primeira consulta?',
    a: 'É uma avaliação de cerca de 30 minutos. A Dra. Daiane examina os dentes, faz a limpeza e conversa com você sobre o que precisa ser feito. Se houver espaço na agenda, o procedimento pode ser iniciado na mesma visita.' },
  { q: 'Quais tratamentos a Dra. Daiane Carvalho realiza?',
    a: 'A Dra. Daiane Carvalho realiza limpeza, com remoção de tártaro e placa; restauração de dentes afetados por cárie ou fratura; clareamento dental; e tratamento de canal, que é a endodontia.' },
  { q: 'A Dra. Daiane faz limpeza e restauração?',
    a: 'Faz. Além do tratamento de canal e do clareamento, o consultório atende limpeza, a remoção de tártaro e placa, e restauração de dentes afetados por cárie ou fratura. A limpeza é feita já na avaliação inicial, que é também quando a Dra. Daiane identifica o que mais precisa de atenção.' },
  { q: 'Vocês atendem aos sábados?',
    a: 'Sim, das 12h às 17h. O atendimento é sempre com hora marcada, em qualquer dia, mas a marcação é rápida e feita pelo WhatsApp, então às vezes dá para encaixar no mesmo dia. O sábado costuma resolver para quem não consegue sair do trabalho durante a semana.' },
  { q: 'Qual é a formação da Dra. Daiane Carvalho?',
    a: 'A Dra. Daiane Carvalho é cirurgiã-dentista formada em Odontologia pela Universidade Nove de Julho e concluiu especialização em Endodontia, a área que trata o canal do dente, na São Leopoldo Mandic, em São Paulo. Está inscrita no CRO-SP sob o número 170242.' },
  { q: 'Estou com dor de dente. O que devo fazer?',
    a: `Mande uma mensagem no WhatsApp ${clinica.telefoneExibicao} descrevendo a dor. Dor de dente forte costuma indicar inflamação da polpa do dente e não melhora sozinha: quanto antes for avaliada, mais simples é o tratamento. Casos de dor são encaixados dentro dos dias de atendimento, e a marcação pelo WhatsApp costuma ser rápida.` },
  { q: 'O consultório atende convênio?',
    a: 'Não. O atendimento no consultório da Dra. Daiane Carvalho é exclusivamente particular, sem convênios.' },
  { q: 'Como agendar uma consulta?',
    a: `O agendamento é feito pelo WhatsApp, no número ${clinica.telefoneExibicao}. Você conta o que está sentindo, a Dra. Daiane avalia o caso e confirma o melhor horário dentro dos dias de atendimento.` },
];

const jsonLd = grafo(dentist(), person(), faqPage(faqItens));
---
<Layout
  title="Consultório odontológico na Barra Funda, São Paulo | Dra. Daiane Carvalho"
  description="Consultório odontológico da Dra. Daiane Carvalho na Barra Funda, São Paulo. Limpeza, restauração, clareamento dental e tratamento de canal. Atendimento particular, de terça a sábado."
  origem="home"
  jsonLd={jsonLd}
>
  <BarraMarca nav={nav} />
  <div class="lp">
    <Hero />
    <Especialidades id="servicos" />
    <Dra
      id="dra-daiane"
      label="Quem cuida do seu sorriso"
      titulo="Dra. Daiane Carvalho"
      texto="A Dra. Daiane Carvalho é cirurgiã-dentista com especialização em Endodontia, a área que trata o canal do dente, e mantém consultório na Barra Funda, em São Paulo. Atende limpeza, restauração, clareamento dental e tratamento de canal, explicando cada etapa com clareza e conduzindo o tratamento no ritmo de cada paciente."
    />
    <Depoimentos id="depoimentos" contexto="home" />
    <Espaco id="consultorio" />
    <FAQ id="duvidas" itens={faqItens} />
    <Rodape ctaMensagem="Olá! Gostaria de combinar um horário no consultório." links={linksRodape} />
  </div>
  <BotaoFlutuante mensagem="Olá! Gostaria de saber mais sobre os atendimentos da Dra. Daiane." />
</Layout>
