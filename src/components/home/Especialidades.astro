---
// Seção "O que oferecemos" da home (Figma: "Incluso").
// Quatro cards; dois deles levam às landings dedicadas.
import TituloSecao from '../TituloSecao.astro';
import CardIcone from '../CardIcone.astro';
import IconeDental from '../IconeDental.astro';
import BotaoWhatsApp from '../BotaoWhatsApp.astro';

interface Props { id?: string; }
const { id } = Astro.props;

const servicos = [
  { icone: 'limpeza', titulo: 'Limpeza e Prevenção',
    texto: 'Remoção de tártaro e placa, feita no consultório. É também o momento em que a Dra. Daiane examina os dentes e identifica o que precisa de atenção.',
    itens: ['Profilaxia', 'Remoção de tártaro', 'Aplicação de flúor', 'Orientação de escovação'] },
  { icone: 'obturacao', titulo: 'Restauração',
    texto: 'Reconstrução do dente afetado por cárie ou fratura, com resina da cor do próprio dente.',
    itens: ['Restauração em resina', 'Reconstrução de dente fraturado', 'Tratamento de cárie'] },
  { icone: 'clareamento', titulo: 'Clareamento dental',
    texto: 'Protocolo feito no consultório para clarear o tom dos dentes, acompanhado sessão a sessão até chegar ao seu branco máximo.',
    itens: ['Clareamento em consultório', 'Avaliação do tom na consulta', 'Acompanhamento sessão a sessão'],
    link: { texto: 'Ver mais', href: '/clareamento/' } },
  { icone: 'canal', titulo: 'Tratamento de canal',
    texto: 'Tratamento da parte interna do dente quando a raiz é atingida. É o que evita a extração e permite manter o dente.',
    itens: ['Tratamento de canal', 'Retratamento de canal', 'Diagnóstico pulpar'],
    link: { texto: 'Ver mais', href: '/endodontia/' } },
] as const;
---
<section class="servicos section" id={id}>
  <div class="container">
    <TituloSecao
      label="O que oferecemos"
      titulo="Tudo o que o seu sorriso precisa, em um só lugar"
      subtitulo="Da rotina aos tratamentos especializados, com atendimento próximo e humano."
    />
    <div class="cards servicos-cards">
      {servicos.map((s) => (
        <CardIcone titulo={s.titulo} texto={s.texto} itens={[...s.itens]} link={s.link}>
          <IconeDental nome={s.icone} />
        </CardIcone>
      ))}
    </div>
    <div class="servicos-cta">
      <BotaoWhatsApp
        texto="Tirar uma dúvida"
        mensagem="Olá! Tenho uma dúvida sobre os atendimentos do consultório."
        posicao="servicos"
        icone={false}
      />
    </div>
  </div>
</section>

<style is:global>
    .servicos { background: var(--superficie-alternada); }
    .servicos-cta { display: flex; justify-content: center; margin-top: var(--spacing-xl); }
    .servicos-cta .btn-whatsapp { width: 100%; }
    @media (min-width: 768px) { .servicos-cta .btn-whatsapp { width: 350px; } }
    @media (min-width: 768px) {
      .servicos-cards { display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-md); }
    }
</style>
