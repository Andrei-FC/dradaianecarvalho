---
// Seção "O que está incluso" (Figma: "Incluso" do clareamento).
// 3 Card Serviço com badge, ícones do banco dental.
import TituloSecao from '../TituloSecao.astro';
import CardIcone from '../CardIcone.astro';
import IconeDental from '../IconeDental.astro';

interface Props { id?: string; }
const { id } = Astro.props;

const itens = [
  { icone: 'limpeza',     badge: 'incluso',        titulo: 'Limpeza profunda',        texto: 'Removemos o tártaro e preparamos os dentes antes de clarear, para o máximo resultado.' },
  { icone: 'clareamento', badge: 'em consultório', titulo: 'Clareamento profissional', texto: 'Produtos profissionais e controle de cada etapa, resultado visível desde as primeiras sessões.' },
  { icone: 'moldeira',    badge: 'incluso',        titulo: 'Clareamento caseiro',      texto: 'Moldeira sob medida + gel profissional de alta qualidade para você clarear em casa e manter o branco por muito mais tempo.' },
] as const;
---
<section class="incluso section" id={id}>
  <div class="container">
    <TituloSecao
      label="O que está incluso"
      titulo="Um tratamento completo, não só o clareamento"
      subtitulo="Da limpeza ao acompanhamento, tudo pensado para o máximo resultado."
    />
    <div class="cards">
      {itens.map((i) => (
        <CardIcone titulo={i.titulo} texto={i.texto} badge={i.badge}>
          <IconeDental nome={i.icone} />
        </CardIcone>
      ))}
    </div>
  </div>
</section>

<style is:global>
    .incluso { background: var(--superficie-alternada); }
</style>
