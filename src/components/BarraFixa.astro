---
// Barra fixa de WhatsApp no rodapé da tela (só mobile).
import BotaoWhatsApp from './BotaoWhatsApp.astro';
interface Props { texto: string; mensagem: string; }
const { texto, mensagem } = Astro.props;
---
<div class="barra-fixa">
  <BotaoWhatsApp texto={texto} mensagem={mensagem} posicao="barra-fixa" />
</div>

<style is:global>
    .barra-fixa {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
      background: var(--superficie-card); border-top: 1px solid var(--borda-sutil);
      padding: var(--spacing-md) var(--spacing-xl);
      box-shadow: 0 -4px 16px rgba(35, 55, 56, 0.08);
    }
    .barra-fixa .btn-whatsapp { width: 100%; }
    @media (min-width: 768px) { .barra-fixa { display: none; } }
</style>
