---
// Passo a passo do clareamento (bloco ESCURO).
import TituloSecao from '../TituloSecao.astro';

interface Props { id?: string; }
const { id } = Astro.props;

const passos = [
  { n: '1', titulo: 'Avaliação',            texto: 'Analisamos seu caso e definimos o protocolo individual.' },
  { n: '2', titulo: 'Limpeza profunda',     texto: 'Removemos o tártaro e preparamos os dentes.' },
  { n: '3', titulo: 'Sessões em consultório', texto: 'Clareamento profissional, quantas forem necessárias.' },
  { n: '4', titulo: 'Medição na escala',    texto: 'A cor é aferida ao fim de cada sessão até estabilizar.' },
] as const;
---
<section class="funciona is-escura section" id={id}>
  <div class="container">
    <TituloSecao label="Como funciona" titulo="Do primeiro contato ao seu branco ideal" />
    <div class="passos">
      {passos.map((p) => (
        <div class="passo">
          <span class="passo-num">{p.n}</span>
          <div>
            <h3 class="tipo-corpo-forte">{p.titulo}</h3>
            <p class="tipo-corpo">{p.texto}</p>
          </div>
        </div>
      ))}
    </div>
    <div class="nota-caseiro">
      <p class="tipo-corpo-forte">E você leva para casa uma moldeira feita sob medida para os seus dentes + o gel profissional, para manter o branco por muito mais tempo.</p>
    </div>
  </div>
</section>

<style is:global>
    .funciona { background: var(--superficie-escura); }
    .funciona h2 { color: var(--texto-sobre-primaria); margin: 0; }
    .funciona .passos { display: flex; flex-direction: column; gap: var(--spacing-md); padding-top: var(--spacing-sm); }
    .funciona .passo { display: flex; gap: var(--spacing-md); align-items: flex-start; }
    .funciona .passo-num {
      background: var(--marca-primaria); color: var(--texto-sobre-primaria);
      width: 40px; height: 40px; border-radius: var(--radius-full); flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      font-weight: 600; font-size: var(--font-size-corpo-forte);
    }
    .funciona .passo h3 { color: var(--texto-sobre-primaria); margin: 0 0 var(--spacing-xs); }
    .funciona .passo p { color: var(--texto-sobre-escuro); margin: 0; }
    .funciona .nota-caseiro {
      background: var(--marca-primaria-escura); border-radius: var(--radius-md);
      padding: var(--spacing-lg); margin-top: var(--spacing-lg);
    }
    .funciona .nota-caseiro p { color: var(--texto-sobre-primaria); margin: 0; }
    @media (min-width: 768px) {
      .funciona .passos { flex-direction: row; gap: var(--spacing-md); }
      .funciona .passo { flex: 1; }
      .funciona .nota-caseiro { max-width: 612px; }
    }
</style>
