---
// Wrapper de seção do card destaque na landing de clareamento.
// Usa o CardDestaque compartilhado (cor mauve). Conteúdo fixo desta landing.
import CardDestaque from '../CardDestaque.astro';
---
<section class="destaque section">
  <div class="container">
    <CardDestaque
      cor="mauve"
      titulo="Protocolo dessensibilizante para o seu conforto"
      texto="Um dos maiores receios de quem quer clarear é a sensibilidade. Por isso, o clareamento aqui inclui um protocolo dessensibilizante aplicado durante as sessões, reduzindo o desconforto e deixando a experiência muito mais tranquila, do começo ao fim."
    />
  </div>
</section>

<style is:global>
    .destaque { background: var(--superficie-pagina); padding-top: 0; }
</style>
