---
// Seção "O que oferecemos" da home (Figma: "Incluso").
// Quatro cards; dois deles levam às landings dedicadas.
import TituloSecao from '../TituloSecao.astro';
import CardIcone from '../CardIcone.astro';
import IconeDental from '../IconeDental.astro';

interface Props { id?: string; }
const { id } = Astro.props;

const servicos = [
  { icone: 'limpeza', titulo: 'Limpeza e Prevenção',
    texto: 'Limpeza profissional, aplicação de flúor e orientações de higiene bucal.',
    itens: ['Profilaxia', 'Remoção de tártaro', 'Aplicação de flúor', 'Orientação de escovação'] },
  { icone: 'obturacao', titulo: 'Clínica Geral',
    texto: 'Tratamentos básicos como restaurações, extrações e check-ups regulares.',
    itens: ['Restaurações', 'Extrações', 'Check-ups', 'Diagnósticos'] },
  { icone: 'clareamento', titulo: 'Estética Dental',
    texto: 'Clareamento e tratamentos para um sorriso mais bonito.',
    itens: ['Clareamento', 'Restaurações estéticas', 'Check-ups'],
    link: { texto: 'Ver mais', href: '/clareamento/' } },
  { icone: 'canal', titulo: 'Endodontia',
    texto: 'Tratamento de canal com tecnologia moderna e menor desconforto.',
    itens: ['Tratamento de canal', 'Retratamento', 'Apicectomia', 'Diagnóstico pulpar'],
    link: { texto: 'Ver mais', href: '/endodontia/' } },
] as const;
---
<section class="servicos section" id={id}>
  <div class="container">
    <TituloSecao
      label="O que oferecemos"
      titulo="Tudo o que o seu sorriso precisa, em um só lugar"
      subtitulo="Da rotina aos tratamentos especializados, com atendimento próximo e humano."
    />
    <div class="cards servicos-cards">
      {servicos.map((s) => (
        <CardIcone titulo={s.titulo} texto={s.texto} itens={[...s.itens]} link={s.link}>
          <IconeDental nome={s.icone} />
        </CardIcone>
      ))}
    </div>
  </div>
</section>

<style is:global>
    .servicos { background: var(--superficie-alternada); }
    @media (min-width: 768px) {
      .servicos-cards { display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-md); }
    }
</style>
