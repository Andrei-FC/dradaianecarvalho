---
// Seção Conforto: um Card Destaque sobre superfície blush.
import CardDestaque from '../CardDestaque.astro';
---
<section class="conforto section">
  <div class="container">
    <CardDestaque
      cor="rosa"
      titulo="Protocolo dessensibilizante para o seu conforto"
      texto="Um dos maiores receios de quem quer realizar o clareamento dental é a sensibilidade. Por isso, o clareamento aqui inclui um protocolo dessensibilizante aplicado durante as sessões, reduzindo o desconforto e deixando a experiência muito mais tranquila, do começo ao fim."
    />
  </div>
</section>

<style is:global>
    .conforto { background: var(--superficie-respiro); }
</style>
