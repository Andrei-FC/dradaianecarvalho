//
// Regra: NUNCA desenhar ícone à mão aqui. Ícone novo entra sempre exportado
// do Figma, pelo mesmo caminho.
interface Props {
  /** chave do ícone no banco */
  nome: keyof typeof BANCO;
  /** lado do quadrado, em px (default 44 = tamanho do Card Serviço) */
  tamanho?: number;
}

