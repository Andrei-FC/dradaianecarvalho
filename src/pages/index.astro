---
import Layout from '../layouts/Layout.astro';
import clinica from '../data/clinica.json';
---
<Layout
  title="Dra. Daiane Carvalho — Endodontia e Clareamento | São Paulo"
  description="Consultório da Dra. Daiane Carvalho em Barra Funda, São Paulo. Endodontia, clareamento e clínica geral."
  origem="home"
>
  <main class="wrap">
    <p class="tipo-label selo">Consultório odontológico &middot; {clinica.bairro}</p>
    <h1 class="tipo-display titulo">{clinica.nome}</h1>
    <p class="tipo-subtitulo sub">Nosso site está sendo atualizado. Em breve, novidades por aqui.</p>
  </main>
</Layout>

<style is:global>
    .wrap {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 32px 24px;
      gap: 20px;
    }
    .selo { color: var(--marca-acento); }
    .titulo { color: var(--texto-titulo); max-width: 16ch; }
    .sub { color: var(--texto-suave); max-width: 40ch; }
</style>
