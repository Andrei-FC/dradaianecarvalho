---
import clinica from '../../data/clinica.json';
// Hero da landing de endodontia.
// Eixo desde 01/10: ESPECIALIDADE, não dor. O H1 nomeia os três serviços porque a
// Campanha B compra `endodontista` e `dentista endodontia` e a página não respondia
// por nenhum dos dois (SITE-MUDANCAS 1.10.1).
// A dor não sumiu da página: foi concentrada na seção do vídeo.
//
// O terceiro serviço é `reabilitação`, não `pino` (SITE-MUDANCAS 1.11.3). A Dra.
// reprovou `pino` em título: ninguém chega dizendo que tem um pino para refazer,
// porque o paciente não sabe que tem um. Vocabulário de chegada não é vocabulário
// de procedimento. A palavra continua na página, mas só dentro de reabilitação.
//
// O artigo some de propósito: `e a reabilitação do dente` leria como etapa final de
// um processo; `e reabilitação do dente` lê como o terceiro item de uma lista de
// serviços. A ambiguidade é intencional — tudo se resolve no mesmo lugar.
//
// O H1 NÃO nomeia a Barra Funda de propósito: o <title> já carrega a cidade, o
// parágrafo de apoio e a seção do consultório dizem, e quem chega pelo anúncio veio
// de um raio de 3 km. A linha mais valiosa não se gasta informando localização.
//
// No desktop a faixa de selos vive AQUI dentro; no mobile ela vira SelosBanda.
import Selos from './Selos.astro';
import BotaoWhatsApp from '../BotaoWhatsApp.astro';

const LEAD_SELOS = 'Atendimento particular com hora marcada, na Barra Funda. A Dra. Daiane avalia o seu caso, explica cada passo e conduz o tratamento com foco no seu conforto. A maioria dos casos é resolvida em uma única sessão.';
// A mensagem perdeu "Estou com dor de dente": quem foi encaminhado pelo próprio
// dentista e não está com dor abria o WhatsApp com uma frase falsa escrita no nome
// dele e fechava em vez de apagar (SITE-MUDANCAS 1.10.4).
const MSG = 'Olá! Gostaria de avaliar um tratamento de canal.';
---
<header class="hero section">
  <div class="container hero-inner">
    <div class="hero-col">
      <div class="hero-title-block">
        <span class="hero-badge tipo-label">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="var(--estrela)" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          100% de avaliações 5 estrelas no Google
        </span>
        <h1 class="tipo-display">Tratamento de canal, retratamento e reabilitação do dente</h1>
        <p class="hero-credencial tipo-label">
          <span class="hero-credencial-nome">{clinica.nome} &middot; {clinica.cro}</span><br />
          <span>Especialização em Endodontia &mdash; São Leopoldo Mandic</span>
        </p>
      </div>
      <p class="lead tipo-subtitulo">Endodontia com radiografia no consultório, diagnóstico na hora e o passo a passo explicado antes de começar.</p>

      <div class="hero-selos">
        <p class="lead tipo-corpo">{LEAD_SELOS}</p>
        <BotaoWhatsApp texto="Descrever o meu caso" mensagem={MSG} posicao="hero" icone={false} />
        <Selos />
      </div>
    </div>
    <div class="ph hero-img"><img fetchpriority="high" decoding="async" width="840" height="938" src="/assets/images/Hero-principal.jpg" alt="Dra. Daiane Carvalho finalizando um tratamento de canal no consultório na Barra Funda, São Paulo"></div>
  </div>
</header>

<style is:global>
    .hero { background: var(--superficie-card); }
    .hero-badge {
      display: inline-flex; align-self: flex-start; width: auto; align-items: center; gap: var(--spacing-xs);
      background: var(--superficie-alternada); color: var(--texto-titulo);
      padding: var(--spacing-xs) var(--spacing-md); border-radius: var(--radius-full);
      margin: 0; text-transform: none; letter-spacing: 0;
    }
    .hero-title-block { display: flex; flex-direction: column; align-items: flex-start; gap: var(--spacing-md); }
    /* A credencial NÃO usa .eyebrow: no Figma ela é cor/texto/suave e só a primeira
       linha é caixa alta — a segunda carrega a especialização em caixa mista. */
    .hero-credencial { color: var(--texto-suave); margin: 0; text-transform: none; }
    .hero-credencial-nome { text-transform: uppercase; }
    .hero-col { display: flex; flex-direction: column; gap: var(--spacing-sm); }
    .hero h1 { color: var(--texto-titulo); margin: 0; }
    .hero .lead { color: var(--texto-suave); margin: 0; }
    /* A foto FLUTUA, como no hero da home. O `border-radius: 0` e o
       `padding-bottom: 0` da seção vinham da versão antiga, em que a imagem era
       colada na base do hero. O raio vem de .ph, que é --radius-md.
       No CELULAR a foto é um recorte central mais baixo — 384x332 no Figma —, e
       não a proporção natural do arquivo. Sem isso ela ocupava quase meia tela e
       empurrava o CTA para fora da dobra. O recorte é centralizado nos dois
       eixos, igual ao Figma, então basta o cover que já vem de .ph.
       No DESKTOP a foto aparece inteira: a altura é a do arquivo, sem proporção
       travada, que era o que cortava qualquer foto diferente de 902x1004. */
    .hero-img { width: 100%; margin-top: var(--spacing-xl); aspect-ratio: 384 / 332; }
    .hero-selos { display: none; }
    @media (min-width: 768px) {
      .hero-img { margin-top: 0; aspect-ratio: auto; }
      .hero-img img { height: auto; object-fit: contain; }
      .hero-inner { display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-2xl); align-items: center; }
      .hero-col { display: flex; flex-direction: column; gap: var(--spacing-2xl); }
      .hero .lead { margin: 0; }
      .hero-selos { display: flex; flex-direction: column; gap: var(--spacing-md); }
      .hero-selos .selo-grid { grid-template-columns: 1fr 1fr; }
      .hero .btn-whatsapp { width: 350px; max-width: 100%; }
    }
</style>
