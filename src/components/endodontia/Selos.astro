---
// 4 mini-cards do hero de endodontia (Figma: "Mini Card").
// Os ícones vêm de DOIS bancos: três do banco de interface e um do dental
// (`icon/dental/dentenovo` no segundo selo). O Figma mapeia assim, e o desenho
// carrega o significado — por isso o `banco` é explícito por selo.
//
// "Anestesia sem dor" saiu em 01/10 e "Salva o dente natural" também. A primeira
// NÃO é frase vedada (o fato clínico é exato, ver SITE-MUDANCAS 1.10.7); saiu por
// espaço, para o hero passar a dizer o que nenhum outro ponto dizia. A segunda saiu
// por ser promessa de resultado.
//
// O segundo selo dizia "Retratamento e pino" até 01/10. `pino` saiu de toda posição
// de título por decisão clínica da Dra. (SITE-MUDANCAS 1.11.2): selo é título.
import IconeUI from '../IconeUI.astro';
import IconeDental from '../IconeDental.astro';

const selos = [
  { label: 'Maioria em 1 sessão',        banco: 'ui',     icone: 'calendario' },
  { label: 'Retratamento e restauração', banco: 'dental', icone: 'dente-novo' },
  { label: 'Radiografia no consultório', banco: 'ui',     icone: 'selo-check' },
  { label: 'Pagamento facilitado',       banco: 'ui',     icone: 'cartao' },
] as const;
---
<div class="selo-grid">
  {selos.map((s) => (
    <div class="selo">
      <span class="selo-ico">
        {s.banco === 'dental'
          ? <IconeDental nome={s.icone} tamanho={20} />
          : <IconeUI nome={s.icone} tamanho={20} />}
      </span>
      <span class="tipo-label selo-label">{s.label}</span>
    </div>
  ))}
</div>

<style is:global>
    .selo-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-md); }
    .selo {
      background: var(--superficie-card); border-radius: var(--radius-md);
      padding: var(--spacing-md); display: flex; align-items: center; gap: var(--spacing-sm);
    }
    .selo-ico {
      background: var(--marca-primaria); border-radius: var(--radius-full);
      width: 32px; height: 32px; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      color: var(--texto-sobre-primaria);
    }
    .selo-label { color: var(--texto-titulo); text-transform: none; letter-spacing: 0; }
</style>
