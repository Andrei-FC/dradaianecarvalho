---
// Seção · Espaço (Figma: "Seção · Espaço"). Antes chamado "Consultório".
// Galeria do espaço físico. Título centralizado por prop.
import TituloSecao from './TituloSecao.astro';
interface Props {
  label?: string;
  titulo?: string;
  subtitulo?: string;
  id?: string;
}
const {
  label = 'Conheça o espaço',
  titulo = 'Um consultório pensado para o seu conforto',
  subtitulo = 'Ambiente acolhedor, equipamentos modernos e todo o cuidado com segurança e higiene, na Barra Funda.',
  id,
} = Astro.props;
---
<section class="espaco is-escura section" id={id}>
    <div class="container">
      <TituloSecao label={label} titulo={titulo} subtitulo={subtitulo} centralizado />
      <div class="galeria">
        <div class="ph"><img src="/assets/images/Consultorio-Dental1.jpg" width="310" height="413" loading="lazy" decoding="async" alt="Sala de atendimento da Dra. Daiane Carvalho, com cadeira odontológica, foco cirúrgico e janela com vista da cidade"></div>
        <div class="ph"><img src="/assets/images/Consultorio-Dental2.jpg" width="310" height="413" loading="lazy" decoding="async" alt="Recepção do consultório na Barra Funda, com banco estofado, iluminação indireta e quadros na parede"></div>
        <div class="ph"><img src="/assets/images/Consultorio-Dental3.jpg" width="310" height="413" loading="lazy" decoding="async" alt="Espaço de cortesia do consultório, com máquina de café e purificador de água à disposição dos pacientes"></div>
      </div>
    </div>
  </section>

<style is:global>
    /* v9: virou bloco ESCURO. É o evento visual que faltava no miolo da página
       e as fotos do consultório ganham muito sobre fundo escuro (seção 9.4). */
    .espaco { background: var(--superficie-escura); }
    .espaco h2 { color: var(--texto-sobre-primaria); }
    .espaco .section-head p { color: var(--texto-sobre-escuro); }
    @media (min-width: 768px) {
      .espaco .galeria .ph img { height: 100%; object-fit: cover; }
    }
</style>
