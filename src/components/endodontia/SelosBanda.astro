---
// Faixa de selos que aparece SÓ no mobile, abaixo do hero.
// No desktop os selos vivem dentro do próprio hero.
//
// SEM CTA. O botão desta faixa saiu quando o CTA do hero subiu para antes da foto
// (SITE-MUDANCAS 1.10.4): os dois ficavam na mesma rolagem, com o mesmo rótulo e a
// mesma mensagem. A dobra era o problema a resolver, não a quantidade de botões.
import Selos from './Selos.astro';

const LEAD = 'Atendimento particular com hora marcada, na Barra Funda. A Dra. Daiane avalia o seu caso, explica cada passo e conduz o tratamento com foco no seu conforto. A maioria dos casos é resolvida em uma única sessão.';
---
<section class="selos section">
  <div class="container">
    <Selos />
    <p class="lead tipo-corpo">{LEAD}</p>
  </div>
</section>

<style is:global>
    .selos { background: var(--superficie-pagina); }
    .selos .lead { color: var(--texto-suave); margin: var(--spacing-lg) 0 0; }
    @media (min-width: 768px) { .selos { display: none; } }
</style>
