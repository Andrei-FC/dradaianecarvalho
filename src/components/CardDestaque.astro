---
// Card Destaque (Figma: "Card Destaque", property Cor).
// Card de respiro para destacar um diferencial. A cor é prop.
//
// v9: as duas variantes foram religadas à paleta nova.
//   cor="teal" → /endodontia. Superfície alternada (champagne) sobre a seção
//                blush do Conforto, com título em texto/titulo (petróleo).
//   cor="rosa" → /clareamento. Herdeira da antiga "mauve".
interface Props {
  titulo: string;
  texto: string;
  cor?: 'teal' | 'rosa';
}
const { titulo, texto, cor = 'rosa' } = Astro.props;
---
<div class:list={['card-destaque', `card-destaque--${cor}`]}>
  <h2 class="tipo-subtitulo">{titulo}</h2>
  <p class="tipo-corpo">{texto}</p>
</div>

<style is:global>
    .card-destaque {
      border-radius: var(--radius-lg);
      padding: var(--spacing-xl); max-width: 800px; margin: 0 auto;
      display: flex; flex-direction: column; gap: var(--spacing-sm);
    }
    .card-destaque p { color: var(--texto-suave); margin: 0; }
    .card-destaque h2 { margin: 0; }
    .card-destaque--teal { background: var(--superficie-alternada); }
    .card-destaque--teal h2 { color: var(--texto-titulo); }
    .card-destaque--rosa { background: var(--superficie-acento-claro); }
    .card-destaque--rosa h2 { color: var(--marca-acento-escura); }
</style>
