diff --git a/src/components/endodontia/Funciona.astro b/src/components/endodontia/Funciona.astro
new file mode 100644
index 0000000..4f9e8cf
--- /dev/null
+++ b/src/components/endodontia/Funciona.astro
@@ -0,0 +1,52 @@
+---
+// Passo a passo do tratamento de canal (bloco escuro), visão do PACIENTE.
+// Nada de fluxo B2B (indicação/formulário do dentista). Aqui é: você chega,
+// avalia, trata — geralmente numa sessão só.
+---
+<section class="funciona section">
+    <div class="container">
+      <div class="section-head">
+        <p class="eyebrow tipo-label">Como funciona</p>
+        <h2 class="tipo-titulo">Do primeiro contato até você sair sem dor</h2>
+      </div>
+      <div class="passos">
+        <div class="passo"><span class="passo-num">1</span><div><h3>Você fala comigo</h3><p>Me conta o que está sentindo pelo WhatsApp e agendamos a sua avaliação.</p></div></div>
+        <div class="passo"><span class="passo-num">2</span><div><h3>Avaliação e raio-X</h3><p>Examino o dente e confirmo se é canal, explicando cada passo com clareza.</p></div></div>
+        <div class="passo"><span class="passo-num">3</span><div><h3>Tratamento com conforto</h3><p>Anestesia bem feita e técnica moderna: o objetivo é você não sentir dor durante.</p></div></div>
+        <div class="passo"><span class="passo-num">4</span><div><h3>Geralmente em 1 sessão</h3><p>A maioria dos casos é finalizada num único atendimento, e você sai aliviada.</p></div></div>
+      </div>
+      <div class="nota-caseiro">
+        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
+        <p>Salvar o dente natural é quase sempre melhor do que extrair. O canal remove a infecção e mantém o seu próprio dente no lugar.</p>
+      </div>
+    </div>
+  </section>
+
+<style is:global>
+    /* Mesmo visual do Funciona de clareamento (bloco teal escuro). */
+    .funciona { background: var(--teal-900); }
+    .funciona .eyebrow { color: var(--mint); }
+    .funciona h2 { color: var(--white); margin: 0; }
+    .funciona .passos { display: flex; flex-direction: column; gap: var(--spacing-md); padding-top: var(--spacing-sm); }
+    .funciona .passo { display: flex; gap: var(--spacing-md); align-items: flex-start; }
+    .funciona .passo-num {
+      background: var(--teal-600); color: var(--white);
+      width: 40px; height: 40px; border-radius: var(--radius-full); flex-shrink: 0;
+      display: flex; align-items: center; justify-content: center;
+      font-weight: 600; font-size: var(--font-size-corpo-forte);
+    }
+    .funciona .passo h3 { color: var(--white); margin: 0 0 var(--spacing-xs); font-weight: 600; font-size: var(--font-size-corpo-forte); }
+    .funciona .passo p { color: var(--teal-100); margin: 0; font-weight: 600; font-size: var(--font-size-label); line-height: 1.3; }
+    .funciona .nota-caseiro {
+      display: flex; gap: var(--spacing-lg); align-items: center;
+      background: var(--teal-800); border-radius: var(--radius-md);
+      padding: var(--spacing-lg); margin-top: var(--spacing-lg);
+    }
+    .funciona .nota-caseiro svg { width: 20px; height: 20px; flex-shrink: 0; stroke: var(--white); fill: none; stroke-width: 2; }
+    .funciona .nota-caseiro p { color: var(--white); margin: 0; font-weight: 600; font-size: var(--font-size-corpo-forte); line-height: 1.5; }
+    @media (min-width: 768px) {
+      .funciona .passos { flex-direction: row; gap: var(--spacing-md); }
+      .funciona .passo { flex: 1; }
+      .funciona .nota-caseiro { max-width: 612px; }
+    }
+</style>
diff --git a/src/components/endodontia/Hero.astro b/src/components/endodontia/Hero.astro
new file mode 100644
index 0000000..7909384
--- /dev/null
+++ b/src/components/endodontia/Hero.astro
@@ -0,0 +1,50 @@
+---
+// Hero da landing de endodontia (paciente final).
+// Ângulo: dor/aflição → resolvo a dor e salvo o dente. Sem promessa de 24h.
+// Espelha a estrutura do Hero de clareamento (2 colunas no desktop).
+import BotaoWhatsApp from '../BotaoWhatsApp.astro';
+---
+<header class="hero-endo hero section">
+  <div class="container hero-inner">
+    <div class="hero-col">
+      <div class="hero-title-block">
+        <span class="hero-badge tipo-label">
+          <svg width="16" height="16" viewBox="0 0 24 24" fill="var(--estrela)" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
+          100% de avaliações 5 estrelas no Google
+        </span>
+        <h1 class="tipo-display">Dor de dente forte? O tratamento de canal tira a dor e salva o seu dente.</h1>
+      </div>
+      <p class="lead tipo-subtitulo">Endodontia com técnica moderna e anestesia bem feita — pra você resolver a dor sem perder o dente.</p>
+
+      <div class="hero-selos">
+        <p class="lead tipo-corpo">Atendimento humanizado, na Barra Funda. A Dra. Daiane avalia o seu caso, explica cada passo e conduz o tratamento com foco no seu conforto — a maioria dos casos é resolvida em uma única sessão.</p>
+        <BotaoWhatsApp texto="Conversar agora" mensagem="Olá! Estou com dor de dente e gostaria de avaliar um tratamento de canal." posicao="hero" />
+      </div>
+    </div>
+    <div class="ph hero-img"><img src="/assets/images/Dra-Daiane-Carvalho.jpg" alt="Dra. Daiane Carvalho, endodontista"></div>
+  </div>
+</header>
+
+<style is:global>
+    /* Reusa quase tudo de .hero (clareamento). Só ajustes pontuais aqui. */
+    .hero-endo .hero-title-block { display: flex; flex-direction: column; align-items: flex-start; gap: var(--spacing-md); }
+    .hero-endo .hero-badge {
+      display: inline-flex; align-self: flex-start; width: auto; align-items: center; gap: var(--spacing-xs);
+      background: var(--teal-50); color: var(--teal-800);
+      padding: var(--spacing-xs) var(--spacing-md); border-radius: var(--radius-full); margin: 0;
+    }
+    .hero-endo.hero { background: var(--superficie-card); }
+    .hero-endo.hero.section { padding-bottom: 0; }
+    .hero-endo .hero-inner { padding-top: var(--spacing-2xl); }
+    .hero-endo .hero-col { display: flex; flex-direction: column; gap: var(--spacing-sm); }
+    .hero-endo h1 { color: var(--texto-titulo); margin: 0; }
+    .hero-endo .lead { color: var(--texto-suave); margin: 0; }
+    .hero-endo .hero-img { aspect-ratio: 382 / 504; width: 100%; border-radius: 0; }
+    .hero-endo .hero-selos { display: none; }
+    @media (min-width: 768px) {
+      .hero-endo .hero-inner { display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-2xl); align-items: center; }
+      .hero-endo .hero-col { display: flex; flex-direction: column; gap: var(--spacing-2xl); }
+      .hero-endo .hero-selos { display: flex; flex-direction: column; gap: var(--spacing-md); }
+      .hero-endo .btn-whatsapp { width: 350px; max-width: 100%; }
+    }
+</style>
diff --git a/src/components/endodontia/Sinais.astro b/src/components/endodontia/Sinais.astro
new file mode 100644
index 0000000..1222ac4
--- /dev/null
+++ b/src/components/endodontia/Sinais.astro
@@ -0,0 +1,54 @@
+---
+// Seção educativa leve: "quando pode ser canal".
+// Reusa o padrão de cards do Incluso (clareamento). Ícones simples (stroke),
+// sem depender de assets. Objetivo: paciente se reconhecer num sintoma e falar
+// no WhatsApp — não é diagnóstico, é reconhecimento.
+import TituloSecao from '../TituloSecao.astro';
+---
+<section class="sinais section">
+  <div class="container">
+    <TituloSecao
+      label="Quando pode ser canal"
+      titulo="Reconhece algum destes sinais?"
+      subtitulo="Não é um diagnóstico — só a avaliação confirma. Mas se algum destes te soa familiar, vale conversar."
+    />
+    <div class="cards sinais-cards">
+      <article class="card">
+        <span class="sinal-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg></span>
+        <h3 class="tipo-subtitulo">Dor forte ou latejante</h3>
+        <p class="tipo-corpo">Aquela dor que pulsa, que aparece sozinha e às vezes piora à noite ou ao deitar.</p>
+      </article>
+      <article class="card">
+        <span class="sinal-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2s5 5 5 10a5 5 0 0 1-10 0c0-5 5-10 5-10z"/></svg></span>
+        <h3 class="tipo-subtitulo">Sensibilidade que não passa</h3>
+        <p class="tipo-corpo">Dói com o quente ou o gelado e a dor demora a ir embora, mesmo depois de tirar o estímulo.</p>
+      </article>
+      <article class="card">
+        <span class="sinal-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/></svg></span>
+        <h3 class="tipo-subtitulo">Dente escurecido</h3>
+        <p class="tipo-corpo">Um dente que mudou de cor e ficou mais acinzentado ou escuro que os vizinhos.</p>
+      </article>
+      <article class="card">
+        <span class="sinal-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-6-4.35-9-8.5C1.5 10 2 6.5 5 5.5c2-.7 3.5.5 4.5 1.8C10.5 6 12 4.8 14 5.5c3 1 3.5 4.5 2 7-3 4.15-4 8.5-4 8.5z"/></svg></span>
+        <h3 class="tipo-subtitulo">Inchaço ou "bolinha" na gengiva</h3>
+        <p class="tipo-corpo">Um inchaço na gengiva perto do dente, às vezes com um carocinho que aparece e some.</p>
+      </article>
+    </div>
+    <p class="sinais-nota tipo-corpo">Sente algo parecido? Me manda uma mensagem contando o que está acontecendo — a gente avalia com calma.</p>
+  </div>
+</section>
+
+<style is:global>
+    .sinais { background: var(--superficie-pagina); }
+    .sinais-cards .card { align-items: flex-start; }
+    .sinal-ico {
+      width: 44px; height: 44px; color: var(--teal-600); flex-shrink: 0;
+      display: flex; align-items: center; justify-content: center;
+    }
+    .sinal-ico svg { width: 28px; height: 28px; stroke: var(--teal-600); }
+    .sinais-nota { color: var(--texto-suave); text-align: center; margin: var(--spacing-lg) 0 0; }
+    @media (min-width: 768px) {
+      .sinais-cards { flex-wrap: wrap; }
+      .sinais-cards .card { flex: 1 1 calc(50% - var(--spacing-md)); }
+    }
+</style>
