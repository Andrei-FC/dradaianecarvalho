---
// Faixa de selos que aparece SÓ no mobile, abaixo do hero.
import SelosGrid from './SelosGrid.astro';
import BotaoWhatsApp from '../BotaoWhatsApp.astro';

const LEAD = 'Sessões ilimitadas em consultório até você atingir o seu branco máximo, com limpeza profunda e clareamento caseiro inclusos por metade do valor desses procedimentos separados.';
---
<section class="selos section">
  <div class="container">
    <SelosGrid />
    <p class="lead tipo-corpo">{LEAD}</p>
    <BotaoWhatsApp texto="Avaliar o meu sorriso" mensagem="Olá! Gostaria de avaliar o meu sorriso para um clareamento." posicao="selos" icone={false} />
  </div>
</section>

<style is:global>
    .selos { background: var(--superficie-pagina); }
    .selos .lead { color: var(--texto-suave); margin: var(--spacing-lg) 0; }
    .selos .btn-whatsapp { width: 100%; }
    @media (min-width: 768px) { .selos { display: none; } }
</style>
