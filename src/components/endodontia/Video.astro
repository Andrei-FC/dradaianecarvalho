---
// Seção do vídeo (Figma: "Branco Máximo" da endodontia).
// Vídeo real da Dra. (YouTube Short _9xsHXtEvO0). Por ser Short é VERTICAL 9:16.
//
// A REGRA QUE GOVERNA ESTE BLOCO: a mesma informação muda de natureza conforme o
// canal. Escrita na página, a explicação da dor é aula — o site ensinando pulpite a
// quem já está com o dente doendo. Dita por ela em vídeo, é demonstração. O texto
// antigo explicava polpa, nervo e infecção aqui; foi removido porque o vídeo já faz
// isso. O que sobrou entrega a explicação ao vídeo em vez de fazê-la.
//
// E é AQUI que a dor mora agora. Ela não precisava sumir da página, precisava parar
// de ser a tese. Concentrá-la nesta seção deixa o resto no eixo de especialidade sem
// deixar órfão quem chega com dor (SITE-MUDANCAS 1.10.2).
import TituloSecao from '../TituloSecao.astro';
import BotaoWhatsApp from '../BotaoWhatsApp.astro';

const PARAGRAFOS = [
  'Se está doendo agora, vou te explicar o que está acontecendo aí dentro',
  'No vídeo, a Dra. Daiane mostra onde fica o canal dentro do dente, de onde vem a dor e o que o tratamento faz ali. Quanto antes você trata, mais simples é resolver. Dor de dente não melhora sozinha.',
  'Nenhum implante é melhor do que o seu próprio dente.',
];
---
<section class="branco section">
  <div class="container branco-inner">
    <div class="branco-col">
      <TituloSecao label="A Dra. Daiane explica" titulo="O que acontece dentro do dente, explicado por quem vai tratar" />
      <div class="branco-textos">
        {PARAGRAFOS.map((t) => <p class="tipo-corpo">{t}</p>)}
      </div>
      <BotaoWhatsApp texto="Tirar uma dúvida" mensagem="Olá! Tenho uma dúvida sobre o tratamento de canal." posicao="video" icone={false} class="branco-cta" />
    </div>
    <div class="branco-video video-vertical">
      <iframe src="https://www.youtube-nocookie.com/embed/_9xsHXtEvO0?rel=0&amp;modestbranding=1&amp;playsinline=1" title="Por que o dente dói e como o tratamento de canal salva o dente" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
    </div>
  </div>
</section>

<style is:global>
    .branco { background: var(--superficie-card); }
    .branco h2 { color: var(--texto-titulo); }
    .branco .branco-textos { display: flex; flex-direction: column; gap: var(--spacing-md); margin: 0 0 var(--spacing-lg); }
    .branco .branco-textos p { color: var(--texto-suave); margin: 0; }
    .branco-video {
      aspect-ratio: 9 / 16; max-width: 300px; margin-inline: auto; width: 100%;
      border-radius: var(--radius-md); overflow: hidden; background: var(--superficie-escura);
    }
    .branco-video iframe { width: 100%; height: 100%; border: 0; display: block; }
    .branco .btn-whatsapp { width: 100%; }
    .branco-inner { display: flex; flex-direction: column; gap: var(--spacing-lg); }
    .branco-col { display: contents; }
    .branco .section-head { order: 1; margin-bottom: 0; }
    .branco .branco-textos { order: 2; }
    .branco-video { order: 3; }
    .branco .branco-cta { order: 4; }
    @media (min-width: 768px) {
      .branco-inner { display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-lg); align-items: center; }
      .branco-col { display: flex; flex-direction: column; gap: var(--spacing-2xl); order: 1; }
      .branco .section-head { order: 0; margin-bottom: 0; }
      .branco .branco-textos { order: 0; margin: 0; }
      .branco .branco-cta { order: 0; }
      .branco-video { order: 2; max-width: 340px; }
      .branco .btn-whatsapp { width: 335px; max-width: 100%; }
    }
</style>
