---
// Layout base compartilhado por todas as páginas.
// Concentra o <head>, o carregamento do Mulish, o tokens.css,
// as tags de medição e o rastreio de clique no wa.me.
// CSS global do site. Vive AQUI e em nenhum outro lugar: quando cada página
// importava o base.css por conta própria, bastava reescrever uma página para
// a linha sumir e o layout inteiro daquela rota cair.
import '../styles/tokens.css';
import '../styles/base.css';

// ============================================================
// MEDIÇÃO
// ------------------------------------------------------------
// GOOGLE ADS (ativo). Serve para o algoritmo de lance.
const GOOGLE_ADS_ID = 'AW-17672469462';

// Rótulo da AÇÃO DE CONVERSÃO do Google Ads.
// PENDENTE: criar em Ads > Objetivos > Conversões > Nova ação de
// conversão > Site > configuração manual com código. O painel devolve
// algo como 'AbC-D_efGhIjK'. Colar aqui e nada mais precisa mudar.
// Enquanto estiver vazio, o clique NÃO é contabilizado como conversão
// no Google Ads — isso é o que bloqueia a F4 (seção 6.7).
const ADS_CONVERSAO_ROTULO = '';

// GA4 (pendente). Serve para análise: origem de tráfego, referral de
// domínios de IA (seção 10.10), busca por marca. O Ads NÃO substitui isto.
// Colar aqui o ID no formato 'G-XXXXXXXXXX'.
const GA4_ID = '';
// ============================================================

interface Props {
  title: string;
  description: string;
  /** rótulo enviado como origem do clique. ex: 'landing_clareamento' */
  origem?: string;
  /** JSON-LD já serializado, injetado no <head> */
  jsonLd?: string;
  /** imagem de compartilhamento. Default: a peça de marca 1200x630. */
  ogImagem?: string;
}

const { title, description, origem = 'site', jsonLd, ogImagem = '/assets/og.jpg' } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://dradaianecarvalho.com.br').href;
const ogImagemAbs = new URL(ogImagem, 'https://dradaianecarvalho.com.br').href;
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <meta property="og:type" content="website" />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Dra. Daiane Carvalho" />
  {/* Sem og:image o link colado no WhatsApp aparece sem miniatura — num
      negócio que converte por WhatsApp, isso é a peça mais visível do site. */}
  <meta property="og:image" content={ogImagemAbs} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="623" />
  <meta property="og:image:alt" content="Dra. Daiane Carvalho — Odontologia e Estética" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImagemAbs} />

  {/* Ícones. O SVG é o principal em navegador moderno; o .ico cobre os antigos;
      o apple-touch precisa ser PNG opaco, senão o iOS preenche o alfa de preto. */}
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#2F5D62" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Mulish:wght@400;600;800&display=swap" rel="stylesheet" />

  {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}

  {/* Google tag (gtag.js) */}
  <script async src={`https://www.googletagmanager.com/gtag/js?id=${GOOGLE_ADS_ID}`}></script>
  <script define:vars={{ GOOGLE_ADS_ID, GA4_ID }} is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    window.gtag = gtag;
    gtag('js', new Date());
    gtag('config', GOOGLE_ADS_ID);
    if (GA4_ID) gtag('config', GA4_ID);
  </script>
</head>
<body>
  <slot />

  {/* ============================================================
      RASTREIO DE CONVERSÃO — dispara no CLIQUE do wa.me.
      A origem vem do Layout; a posição vem do data-pos do botão.
      Dois disparos, com papéis diferentes:
        1. 'conversion' com send_to  -> alimenta o lance do Google Ads
        2. 'clique_whatsapp'         -> alimenta a análise no GA4
      ============================================================ */}
  <script define:vars={{ origem, GOOGLE_ADS_ID, ADS_CONVERSAO_ROTULO }} is:inline>
    document.querySelectorAll('.js-wa').forEach(function (el) {
      el.addEventListener('click', function () {
        if (typeof window.gtag !== 'function') return;
        var posicao = this.dataset.pos || 'principal';

        if (ADS_CONVERSAO_ROTULO) {
          window.gtag('event', 'conversion', {
            send_to: GOOGLE_ADS_ID + '/' + ADS_CONVERSAO_ROTULO
          });
        }

        window.gtag('event', 'clique_whatsapp', {
          origem: origem,
          posicao: posicao
        });
      });
    });
  </script>
</body>
</html>
