---
// Seção "Quem cuida do seu sorriso" — Dra. Daiane + link do Instagram.
// O link do Instagram vem do clinica.json.
import clinica from '../data/clinica.json';
import TituloSecao from './TituloSecao.astro';
// Texto e título variam por página (clareamento x endodontia) → props com
// default no texto original de clareamento, para não quebrar aquela landing.
interface Props {
  label?: string;
  titulo?: string;
  texto?: string;
}
const {
  label = 'Quem cuida do seu sorriso',
  titulo = 'Dra. Daiane Carvalho',
  texto = 'Cirurgiã-dentista apaixonada por transformar sorrisos e cuidar de pessoas com acolhimento e atenção. Atuo com foco em clareamento e estética do sorriso, com tratamentos modernos, confortáveis e resultados naturais.',
} = Astro.props;
---
<section class="dra section">
    <div class="container dra-inner">
      <div>
        <TituloSecao label={label} titulo={titulo} />
        <p class="lead tipo-corpo">{texto}</p>
        <a class="btn-link" href={clinica.instagram} target="_blank" rel="noopener">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
<path d="M16.017 2H7.947C6.37015 2.00185 4.85844 2.62914 3.74353 3.74424C2.62862 4.85933 2.00159 6.37115 2 7.948L2 16.018C2.00185 17.5948 2.62914 19.1066 3.74424 20.2215C4.85933 21.3364 6.37115 21.9634 7.948 21.965H16.018C17.5948 21.9631 19.1066 21.3359 20.2215 20.2208C21.3364 19.1057 21.9634 17.5938 21.965 16.017V7.947C21.9631 6.37015 21.3359 4.85844 20.2208 3.74353C19.1057 2.62862 17.5938 2.00159 16.017 2V2ZM19.957 16.017C19.957 16.5344 19.8551 17.0468 19.6571 17.5248C19.4591 18.0028 19.1689 18.4371 18.803 18.803C18.4371 19.1689 18.0028 19.4591 17.5248 19.6571C17.0468 19.8551 16.5344 19.957 16.017 19.957H7.947C6.90222 19.9567 5.90032 19.5415 5.16165 18.8026C4.42297 18.0638 4.008 17.0618 4.008 16.017V7.947C4.00827 6.90222 4.42349 5.90032 5.16235 5.16165C5.90122 4.42297 6.90322 4.008 7.948 4.008H16.018C17.0628 4.00827 18.0647 4.42349 18.8034 5.16235C19.542 5.90122 19.957 6.90322 19.957 7.948V16.018V16.017Z" fill="#476D6E"/>
<path d="M11.982 6.81909C10.6134 6.82121 9.30153 7.36588 8.3339 8.3337C7.36627 9.30152 6.82185 10.6135 6.82 11.9821C6.82159 13.351 7.36602 14.6634 8.3339 15.6315C9.30178 16.5996 10.6141 17.1442 11.983 17.1461C13.3521 17.1445 14.6647 16.5999 15.6327 15.6318C16.6008 14.6637 17.1454 13.3512 17.147 11.9821C17.1449 10.6132 16.5999 9.30098 15.6317 8.33329C14.6634 7.3656 13.3509 6.82141 11.982 6.82009V6.81909ZM11.982 15.1381C11.1452 15.1381 10.3428 14.8057 9.75108 14.214C9.1594 13.6223 8.827 12.8198 8.827 11.9831C8.827 11.1463 9.1594 10.3438 9.75108 9.75217C10.3428 9.16049 11.1452 8.82809 11.982 8.82809C12.8188 8.82809 13.6212 9.16049 14.2129 9.75217C14.8046 10.3438 15.137 11.1463 15.137 11.9831C15.137 12.8198 14.8046 13.6223 14.2129 14.214C13.6212 14.8057 12.8188 15.1381 11.982 15.1381Z" fill="#476D6E"/>
<path d="M17.156 8.09509C17.8392 8.09509 18.393 7.54127 18.393 6.85809C18.393 6.17492 17.8392 5.62109 17.156 5.62109C16.4728 5.62109 15.919 6.17492 15.919 6.85809C15.919 7.54127 16.4728 8.09509 17.156 8.09509Z" fill="#476D6E"/>
</svg>
          Siga a Dra. Daiane
        </a>
      </div>
      <div class="ph dra-img"><img src="/assets/images/Dra-Daiane-Carvalho.jpg" alt="Dra. Daiane Carvalho"></div>
    </div>
  </section>

<style is:global>
    .dra { background: var(--superficie-card); }
    .dra.section { padding-bottom: 0; }
    .dra-inner { padding-top: var(--spacing-2xl); }
    .dra .lead { color: var(--texto-suave); margin: 0 0 var(--spacing-lg); }
    .dra-img { aspect-ratio: 382 / 504; width: 100%; margin-top: var(--spacing-lg); border-radius: 0; }
    .btn-link {
      display: inline-flex; align-items: center; gap: var(--spacing-sm);
      background: transparent; color: var(--marca-primaria);
      border: none; border-radius: var(--radius-md);
      padding: var(--spacing-sm) var(--spacing-xs); font-weight: 800; font-size: 16px;
      text-decoration: underline; cursor: pointer;
    }
    .btn-link svg { width: 24px; height: 24px; flex-shrink: 0; }
    .btn-link:focus-visible { outline: 3px solid var(--marca-primaria-escura); outline-offset: 2px; }
    @media (min-width: 768px) {
      .dra-inner { display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-2xl); align-items: center; max-width: 800px; }
      .dra-img { margin-top: 0; order: 2; max-width: 382px; }
    }
</style>
