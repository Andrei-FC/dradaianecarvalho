---
// FAQ genérico. As perguntas variam por página, então vêm por prop.
//
// SEÇÃO 10.3 (legibilidade por IA): usa <details> NATIVO de propósito. O texto
// da resposta fica no HTML mesmo com o item fechado — só está escondido por CSS
// do navegador. Crawler e modelo leem todos os itens. NUNCA injetar a resposta
// por JS: isso apagaria justamente o conteúdo mais citável do site.
//
// O primeiro item abre por padrão. É affordance pura, para a pessoa entender
// que aquilo clica; não muda nada em legibilidade.
interface Item { q: string; a: string; }
interface Props {
  itens: Item[];
  titulo?: string;
  eyebrow?: string;
  id?: string;
}
const { itens, titulo = 'Tudo o que você quer saber', eyebrow = 'Perguntas frequentes', id } = Astro.props;
import TituloSecao from './TituloSecao.astro';
---
<section class="faq section" id={id}>
  <div class="container">
    <TituloSecao label={eyebrow} titulo={titulo} />
    {itens.map((item, i) => (
      <details open={i === 0}>
        <summary class="tipo-corpo-forte">{item.q}</summary>
        <p class="tipo-corpo" set:html={item.a}></p>
      </details>
    ))}
  </div>
</section>

<style is:global>
    .faq { background: var(--superficie-pagina); }
    .faq details {
      background: var(--superficie-card); border: 1px solid var(--borda-sutil);
      border-radius: var(--radius-md); padding: var(--spacing-lg); margin-bottom: var(--spacing-md);
    }
    .faq summary {
      color: var(--texto-forte);
      cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: var(--spacing-md);
    }
    .faq summary::-webkit-details-marker { display: none; }
    .faq summary::after {
      content: "▸"; color: var(--marca-primaria); font-size: 16px; flex-shrink: 0;
      transition: transform 0.2s ease;
    }
    .faq details[open] summary::after { content: "▾"; }
    .faq details p { color: var(--texto-suave); margin: var(--spacing-md) 0 0; }
</style>
