diff --git a/src/components/home/Especialidades.astro b/src/components/home/Especialidades.astro
new file mode 100644
index 0000000..ca8f229
--- /dev/null
+++ b/src/components/home/Especialidades.astro
@@ -0,0 +1,83 @@
+---
+// Seção de especialidades da HOME.
+// Menção às 4 áreas. Endodontia e clareamento têm landing dedicada (link);
+// clínica geral e botox são SÓ MENÇÃO, sem Ads e sem landing (ver PROJETO §2.5).
+// Cards com link recebem a classe .esp-card--link e uma seta.
+import TituloSecao from '../TituloSecao.astro';
+
+const especialidades = [
+  {
+    titulo: 'Clínica geral',
+    texto: 'Limpeza, restaurações e o cuidado de rotina para manter a saúde da sua boca em dia.',
+    href: null,
+  },
+  {
+    titulo: 'Endodontia',
+    texto: 'Tratamento de canal com foco em resolver a dor e preservar o seu dente.',
+    href: '/endodontia',
+  },
+  {
+    titulo: 'Clareamento',
+    texto: 'Sessões até o seu branco máximo, com limpeza profunda e clareamento caseiro inclusos.',
+    href: '/clareamento',
+  },
+  {
+    titulo: 'Estética do sorriso',
+    texto: 'Procedimentos para harmonizar e valorizar o seu sorriso, com resultados naturais.',
+    href: null,
+  },
+];
+---
+<section class="especialidades section">
+  <div class="container">
+    <TituloSecao
+      label="O que oferecemos"
+      titulo="Tudo o que o seu sorriso precisa, em um só lugar"
+      subtitulo="Da rotina aos tratamentos especializados, com atendimento próximo e humano."
+    />
+    <div class="esp-grid">
+      {especialidades.map((e) => {
+        const inner = (
+          <>
+            <h3 class="tipo-subtitulo">{e.titulo}</h3>
+            <p class="tipo-corpo">{e.texto}</p>
+            {e.href && (
+              <span class="esp-link">
+                Ver mais
+                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
+              </span>
+            )}
+          </>
+        );
+        return e.href
+          ? <a class="esp-card esp-card--link" href={e.href}>{inner}</a>
+          : <article class="esp-card">{inner}</article>;
+      })}
+    </div>
+  </div>
+</section>
+
+<style is:global>
+    .especialidades { background: var(--superficie-pagina); }
+    .esp-grid { display: flex; flex-direction: column; gap: var(--spacing-md); padding-top: var(--spacing-md); }
+    .esp-card {
+      background: var(--superficie-card); border: 1px solid var(--borda-sutil);
+      border-radius: var(--radius-lg); padding: var(--spacing-xl);
+      display: flex; flex-direction: column; gap: var(--spacing-sm);
+    }
+    .esp-card h3 { color: var(--texto-titulo); margin: 0; }
+    .esp-card p { color: var(--texto-suave); margin: 0; }
+    .esp-card--link { text-decoration: none; transition: border-color 0.18s ease, transform 0.18s ease; }
+    .esp-card--link:hover { border-color: var(--marca-primaria); transform: translateY(-2px); }
+    .esp-card--link:focus-visible { outline: 3px solid var(--marca-primaria-escura); outline-offset: 2px; }
+    .esp-link {
+      display: inline-flex; align-items: center; gap: var(--spacing-xs);
+      color: var(--marca-primaria); font-weight: 800; font-size: 16px;
+      margin-top: var(--spacing-xs);
+    }
+    .esp-link svg { flex-shrink: 0; }
+    @media (min-width: 768px) {
+      .esp-grid { flex-direction: row; flex-wrap: wrap; }
+      .esp-card { flex: 1 1 calc(50% - var(--spacing-md)); }
+    }
+</style>
diff --git a/src/components/home/Hero.astro b/src/components/home/Hero.astro
new file mode 100644
index 0000000..c71a3b1
--- /dev/null
+++ b/src/components/home/Hero.astro
@@ -0,0 +1,48 @@
+---
+// Hero institucional da HOME.
+// Âncora de marca/reputação (ver PROJETO §2.5): quem é, onde é, prova social,
+// CTA ativo. NÃO é hero de conversão de tráfego pago — esse tom mora nas landings.
+// No desktop: 2 colunas (texto + foto). No mobile: empilhado.
+import BotaoWhatsApp from '../BotaoWhatsApp.astro';
+import clinica from '../../data/clinica.json';
+---
+<header class="hero-home section">
+  <div class="container hero-home-inner">
+    <div class="hero-home-col">
+      <div class="hero-home-title-block">
+        <span class="hero-badge tipo-label">
+          <svg width="16" height="16" viewBox="0 0 24 24" fill="var(--estrela)" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
+          31 avaliações 5 estrelas no Google
+        </span>
+        <h1 class="tipo-display">Cuidado odontológico completo, na Barra Funda</h1>
+      </div>
+      <p class="lead tipo-subtitulo">O consultório da Dra. Daiane Carvalho reúne clínica geral, endodontia, clareamento e estética do sorriso — com acolhimento e atenção a cada paciente.</p>
+      <p class="lead tipo-corpo">Da limpeza de rotina ao tratamento de canal, você é atendido em um só lugar, por quem cuida do seu sorriso de perto.</p>
+      <BotaoWhatsApp texto="Falar com o consultório" mensagem="Olá! Gostaria de saber mais sobre os atendimentos da Dra. Daiane." posicao="hero" />
+    </div>
+    <div class="ph hero-home-img"><img src="/assets/images/Dra-Daiane-Carvalho.jpg" alt="Dra. Daiane Carvalho no consultório"></div>
+  </div>
+</header>
+
+<style is:global>
+    .hero-home { background: var(--superficie-card); }
+    .hero-home.section { padding-bottom: 0; }
+    .hero-home-inner { padding-top: var(--spacing-2xl); }
+    .hero-home-title-block { display: flex; flex-direction: column; align-items: flex-start; gap: var(--spacing-md); }
+    .hero-home-col { display: flex; flex-direction: column; gap: var(--spacing-lg); }
+    .hero-home h1 { color: var(--texto-titulo); margin: 0; }
+    .hero-home .lead { color: var(--texto-suave); margin: 0; }
+    .hero-badge {
+      display: inline-flex; align-self: flex-start; width: auto; align-items: center; gap: var(--spacing-xs);
+      background: var(--teal-50); color: var(--teal-800);
+      padding: var(--spacing-xs) var(--spacing-md); border-radius: var(--radius-full);
+      margin: 0;
+    }
+    .hero-home-img { aspect-ratio: 382 / 504; width: 100%; border-radius: 0; margin-top: var(--spacing-lg); }
+    @media (min-width: 768px) {
+      .hero-home-inner { display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-2xl); align-items: center; }
+      .hero-home-col { gap: var(--spacing-xl); }
+      .hero-home-img { margin-top: 0; max-width: 382px; }
+      .hero-home .btn-whatsapp { width: 350px; max-width: 100%; }
+    }
+</style>
