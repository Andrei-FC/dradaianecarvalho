---
// Seção educativa leve: "quando pode ser canal".
// Compõe o átomo CardIcone (mesmo card do Incluso). Sem badge; grid 2x2 no desktop.
// Não é diagnóstico — é reconhecimento, pra o paciente se identificar e falar no WhatsApp.
import TituloSecao from '../TituloSecao.astro';
import CardIcone from '../CardIcone.astro';
---
<section class="sinais section">
  <div class="container">
    <TituloSecao
      label="Quando pode ser canal"
      titulo="Reconhece algum destes sinais?"
      subtitulo="Não é um diagnóstico — só a avaliação confirma. Mas se algum destes te soa familiar, vale conversar."
    />
    <div class="cards sinais-cards">
      <CardIcone titulo="Dor forte ou latejante" texto="Aquela dor que pulsa, que aparece sozinha e às vezes piora à noite ou ao deitar.">
        <svg viewBox="0 0 24 24" fill="none" stroke="var(--teal-600)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
      </CardIcone>
      <CardIcone titulo="Sensibilidade que não passa" texto="Dói com o quente ou o gelado e a dor demora a ir embora, mesmo depois de tirar o estímulo.">
        <svg viewBox="0 0 24 24" fill="none" stroke="var(--teal-600)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2s5 5 5 10a5 5 0 0 1-10 0c0-5 5-10 5-10z"/></svg>
      </CardIcone>
      <CardIcone titulo="Dente escurecido" texto="Um dente que mudou de cor e ficou mais acinzentado ou escuro que os vizinhos.">
        <svg viewBox="0 0 24 24" fill="none" stroke="var(--teal-600)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/></svg>
      </CardIcone>
      <CardIcone titulo={'Inchaço ou "bolinha" na gengiva'} texto="Um inchaço na gengiva perto do dente, às vezes com um carocinho que aparece e some.">
        <svg viewBox="0 0 24 24" fill="none" stroke="var(--teal-600)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-6-4.35-9-8.5C1.5 10 2 6.5 5 5.5c2-.7 3.5.5 4.5 1.8C10.5 6 12 4.8 14 5.5c3 1 3.5 4.5 2 7-3 4.15-4 8.5-4 8.5z"/></svg>
      </CardIcone>
    </div>
    <p class="sinais-nota tipo-corpo">Sente algo parecido? Me manda uma mensagem contando o que está acontecendo — a gente avalia com calma.</p>
  </div>
</section>

<style is:global>
    .sinais { background: var(--superficie-pagina); }
    /* ícones de Sinais são stroke, menores que os 44px preenchidos do Incluso */
    .sinais .card-ico svg { width: 28px; height: 28px; }
    .sinais-nota { color: var(--texto-suave); text-align: center; margin: var(--spacing-lg) 0 0; }
    @media (min-width: 768px) {
      .sinais-cards { flex-wrap: wrap; }
      .sinais-cards .card { flex-basis: calc(50% - var(--spacing-md)); }
    }
</style>
